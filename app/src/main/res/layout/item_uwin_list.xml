<?xml version="1.0" encoding="utf-8"?>
<!--
    item_uwin_list · redesign.
    Generated by design/redesign-tools/convert_simple_card.py (redesign card: title + icons, label/value grid, tonal action).
    Every TextView / ImageView / Button id, binding and click is kept. Old layout: legacy_item_uwin_list.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <data>

        <variable
            name="uwin"
            type="org.piramalswasthya.sakhi.model.UwinCache" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.UwinListAdapter.UwinClickListener" />



    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ll_uwin_detail"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    android:id="@+id/tvHeaderDate"
                    app:formattedSessionDate="@{uwin.sessionDate}"
                    android:tag="monthYear"
                    tools:text="Date" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:id="@+id/iv_sync_state"
                    android:contentDescription="@string/iv_sync_state_tv"
                    app:syncState="@{uwin.syncState}"
                    tools:src="@drawable/cloud_upload" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    android:id="@+id/tvSessionDate"
                    app:formattedSessionDate="@{uwin.sessionDate}"
                    android:tag="default" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    android:id="@+id/tvPlace"
                    app:setUWINLocalization="@{uwin.place}" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    android:id="@+id/tvParticipants"
                    android:text="@{@string/participant_label(uwin.participantsCount)}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:gravity="end"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Sakhi.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnView"
                    android:onClick="@{() -> clickListener.onClick(uwin.id)}"
                    android:text="@string/ds_view" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
