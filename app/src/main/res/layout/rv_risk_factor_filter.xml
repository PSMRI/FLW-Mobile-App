<?xml version="1.0" encoding="utf-8"?>
<!--
    Risk-factor filter chip (vulnerable population filter sheet) · redesign (row 26), same as rv_tab.xml: 40dp pill that fills its
    grid cell, 4dp around, label 14/20 one line (auto-shrinks to 11sp). Colours (selected = filled primary, else outlined) are set by
    ui/design/FilterChip.kt from VulnerableFilterBottomSheetAdapter. Ids unchanged. Old layout: legacy_rv_risk_factor_filter.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>


        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.VulnerableFilterBottomSheetAdapter" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cMainLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="@dimen/ds_space_2xs"
        android:background="@drawable/bg_ds_filter_chip_off"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/monthText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/ds_space_xs"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
            android:textColor="@color/ds_on_surface_variant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1 month" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
