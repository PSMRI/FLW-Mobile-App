<?xml version="1.0" encoding="utf-8"?><!--
  One claimed record on the Mitanin Trainer / ANM single-activity screen.

  BRD 164692128 §19.3/§19.4: every row is approved or rejected on the spot with its own tick and
  cross — there is no checkbox and no bulk footer at this level. A beneficiary-linked claim shows
  the beneficiary block; a meeting/register claim shows the date it happened instead, so the
  reviewer is checking something real rather than ticking a blank box.

  Flat by design: the rows live inside a single card owned by fragment_beneficiary_detail.

  Redesign (tokens only — no Figma frame for this reviewer row; text styles from Figma "Info row" / list card):
  white row, 1dp #DCE1E8 divider; S.No 14/20 Medium; Ben ID 12/16 Medium primary; name 16/24 Medium #191C1F;
  RCH / ABHA / date 12/16 #42474E; amount 16/24 Medium. Column geometry (icon sizes, paddings, @dimen/mt_row_*) is
  unchanged so the hand-built header in fragment_beneficiary_detail still lines up. Ids unchanged.
  Old layout: legacy_layout_mt_inner.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ds_surface_container"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Approve: immediate, no confirmation sheet -->
    <ImageView
        android:id="@+id/btnApprove"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/approve"
        android:src="@drawable/ic_check_circle_green"
        app:layout_constraintBottom_toBottomOf="@id/llInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/llInfo" />

    <!-- Reject: opens the reason sheet for this row only -->
    <ImageView
        android:id="@+id/btnReject"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reject"
        android:src="@drawable/ic_crossed_circle"
        app:layout_constraintBottom_toBottomOf="@id/btnApprove"
        app:layout_constraintStart_toEndOf="@id/btnApprove"
        app:layout_constraintTop_toTopOf="@id/btnApprove" />

    <!-- Fixed width, and the same gone-margin as the header spacer: read-only rows hide the two
         action icons, and the S.No column must land in the same place either way. -->
    <TextView
        android:id="@+id/tvSerialNo"
        android:layout_width="@dimen/mt_row_serial_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mt_row_serial_margin"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
        android:textColor="@color/ds_on_surface"
        app:layout_constraintBottom_toBottomOf="@id/btnApprove"
        app:layout_constraintStart_toEndOf="@id/btnReject"
        app:layout_constraintTop_toTopOf="@id/btnApprove"
        app:layout_goneMarginStart="@dimen/mt_row_serial_margin"
        tools:text="1" />

    <LinearLayout
        android:id="@+id/llInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mt_row_info_margin"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/tvAmount"
        app:layout_constraintStart_toEndOf="@id/tvSerialNo"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Shown for claims with no beneficiary behind them (meetings, registers) -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
            android:textColor="@color/ds_on_surface_variant"
            android:visibility="gone"
            tools:text="Date: 06 Jul 2026"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvBenId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
            android:textColor="@color/ds_primary"
            tools:text="Ben ID: 664547959811" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
            android:textColor="@color/ds_on_surface"
            tools:text="RAJA SING" />

        <TextView
            android:id="@+id/tvRchId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            tools:text="RCH ID: 123456789" />

        <TextView
            android:id="@+id/tvAbhaNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            tools:text="ABHA Number: 12-3456-7890-1234" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
        android:textColor="@color/ds_on_surface"
        app:layout_constraintBottom_toBottomOf="@id/llInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/llInfo"
        tools:text="₹150" />

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/ds_outline_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llInfo" />

</androidx.constraintlayout.widget.ConstraintLayout>
