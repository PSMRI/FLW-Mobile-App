<?xml version="1.0" encoding="utf-8"?>
<!--
    Picked-file thumbnail (grid of 3 in layout_multi_file_upload) · redesign (Figma M2.2-26 "Photo tile"): 104dp-ish
    tile, #EEF1F5, 1dp #DCE1E8, r12, image cropped to the tile; 4dp around each tile (≈ 8–12dp gaps).
    Ids unchanged; old layout: legacy_layout_file_view.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/ds_space_2xs">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:cardBackgroundColor="@color/ds_surface_container_high"
        app:cardCornerRadius="@dimen/ds_radius_md">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/days"
            android:scaleType="centerCrop"
            android:src="@drawable/img_assam_logo" />
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
