<?xml version="1.0" encoding="utf-8"?>
<!--
    NCD / TPT follow-up history block (one per visit) · redesign (Figma M2.7 follow-up history): 16dp side margins,
    12dp apart, visit title 16/24 Medium #191C1F, 8dp to the follow-up rows. Ids unchanged;
    old layout: legacy_layout_ncd_followup_table.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_followup_history"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_space_md"
    android:layout_marginTop="@dimen/ds_space_sm"
    android:layout_marginEnd="@dimen/ds_space_md"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_visit_header"
        style="@style/Sakhi.G25.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/ds_space_xs"
        android:text=""
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_followups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
