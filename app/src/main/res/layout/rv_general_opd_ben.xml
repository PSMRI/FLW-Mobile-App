<?xml version="1.0" encoding="utf-8"?>
<!--
    General OP care beneficiary card · redesign (row 26), Figma M2.8-16 "General OP care" + the list-card pattern (rows 9 / 17):
    white card 1dp #DCE1E8 r16, padding 16; header = 44dp initials avatar + name 16/24 + meta "gender · age" 14/20 + 44dp call circle;
    hairline; 2-column detail grid (label 11/16 · value 14/20). All data bindings and ids the adapter uses are kept
    (age, registration_date). "Referred to" / "Referral reason" values were tools-only in the old card (always empty) — unchanged.
    Old layout: legacy_rv_general_opd_ben.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="ben"
            type="org.piramalswasthya.sakhi.model.GeneralOPEDBeneficiary" />

        <variable
            name="callclickListener"
            type="org.piramalswasthya.sakhi.adapters.GeneralOPDAdapter.CallClickListener" />

        <variable
            name="showAbha"
            type="Boolean" />

        <variable
            name="showSyncIcon"
            type="Boolean" />

        <variable
            name="hasAbha"
            type="Boolean" />

        <variable
            name="showRegistrationDate"
            type="Boolean" />
        <variable
            name="father"
            type="Boolean" />
        <variable
            name="husband"
            type="Boolean" />
        <variable
            name="spouse"
            type="Boolean"/>

        <variable
            name="role"
            type="Integer" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_md">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:id="@+id/ll_title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{ben.benName}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container"
                        tools:text="HM" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/ll_title_bar_ll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{ben.benName}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface"
                        tools:text="Hello Meister" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@{ben.genderName}"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                            android:textColor="@color/ds_on_surface_variant"
                            tools:text="Female" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/ds_dot_separator"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                            android:textColor="@color/ds_on_surface_variant" />

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                            android:textColor="@color/ds_on_surface_variant"
                            tools:text="45 Years" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_call"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_success_container"
                    android:contentDescription="@string/mobile_number"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:onClick="@{()->callclickListener.onClickCall(ben)}"
                    android:padding="12dp"
                    android:src="@drawable/ic_ds_call"
                    app:tint="@color/ds_success" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:background="@color/ds_outline_variant" />

            <!-- ===== Details (2-column grid) ===== -->
                <LinearLayout
                    android:id="@+id/ll_ben_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ncd_husband_name"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs"
                        showLayout="@{husband}">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_husband_name_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.spouseName}"
                            tools:text="Dummy" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/ncd_father_name"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs"
                        showLayout="@{father}">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_father_name_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.fatherName}"
                            tools:text="Dummy" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/ncd_spouse_name"
                        style="@style/Sakhi.InfoCell"
                        showLayout="@{spouse}">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_spouse_name_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.spouseName}"
                            tools:text="Dummy" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_ben_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/registration_date"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs"
                        showLayout="@{showRegistrationDate}">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/registration_date" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.registrationDate.split(`T`)[0]}"
                            tools:text="12-12-4523" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            benIdText="@{ben.beneficiaryId}"
                            tools:text="Lala Land" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/mobile_number"
                            android:id="@+id/mob" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.preferredPhoneNum}"
                            tools:text="0123456789" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/follow_up_date"
                            android:id="@+id/followupdate" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.consultationDate.split(`T`)[0]}"
                            tools:text="0123456789" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_ben_details_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/hwc_visit_date"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/referred_date" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.benVisitDate.split(`T`)[0]}"
                            tools:text="12-12-4523" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/referred_to" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            tools:text="@{ben.visitCategory.toString()}" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_ben_details_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/refereal_from"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/referred_from" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.village}"
                            tools:text="12-12-4523" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/referral_reason" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            tools:text="@{ben.visitReason.toString()}" />
                    </LinearLayout>
                </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
