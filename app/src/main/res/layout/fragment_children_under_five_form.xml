<?xml version="1.0" encoding="utf-8"?>
<!--
    Children under 5 form shell (SAM / ORS / IFA visits, dynamic form engine) · redesign (Figma M2.4 SAM / ORS forms,
    shell as fragment_new_form): surface #F5F7FA, child card on top, fields inside a white section card (r16, 1dp
    #DCE1E8), bottle table, white bottom action bar with a 48dp filled pill Submit, follow-up visits list below it,
    edit FAB in primary. Ids unchanged; old layout: legacy_fragment_children_under_five_form.xml.
    Not built: the fields themselves are created in code by FormRendererAdapter.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.piramalswasthya.sakhi.utils.SafeNestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_md">

                <FrameLayout
                    android:id="@+id/infant_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_md" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Sakhi.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingVertical="@dimen/ds_space_xs" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </org.piramalswasthya.sakhi.utils.SafeNestedScrollView>

        <include
            android:id="@+id/include_bottle_table"
            layout="@layout/layout_bottle_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            style="@style/Sakhi.G25.BottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/ds_space_sm"
                android:text="@string/submit" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_follow_up_visits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ds_space_md"
            android:visibility="gone"
           />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/ds_space_md"
        android:layout_marginBottom="80dp"
        android:contentDescription="@string/edit"
        android:src="@drawable/ic_edit"
        android:visibility="gone"
        app:backgroundTint="@color/ds_primary"
        app:tint="@color/ds_on_primary"
        tools:visibility="visible" />
</FrameLayout>
