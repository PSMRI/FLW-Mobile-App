<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.1-05 "My journey" — greeting card (primary r24, padding 20, gap 8: greeting 22/28 white,
     narrative 16/24 primary-container), "Today" / "Since you joined" stat tiles (success / primary tones r16, padding 12),
     "Recent badges" section header 16/24, outlined "See all badges". Padding 16, gap 16.
     Old layout: legacy_fragment_journey.xml. Ids unchanged. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Figma "Greeting" card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_abha_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_journey_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
                android:textColor="@color/ds_on_primary"
                tools:text="Good evening, Sunita" />

            <TextView
                android:id="@+id/tv_journey_narrative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                android:textColor="@color/ds_primary_container"
                tools:text="You made a positive difference in your community today." />
        </LinearLayout>

        <!-- "Today" / "Since you joined" as stat tiles (one line of text each from code) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_journey_today"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_stat"
                android:backgroundTint="@color/ds_success_container"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_success"
                tools:text="Today's recorded services: 4" />

            <TextView
                android:id="@+id/tv_journey_lifetime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_stat"
                android:backgroundTint="@color/ds_primary_container"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_primary"
                tools:text="Total recorded services: 812" />
        </LinearLayout>

        <!-- Figma "Section header" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/journey_badge_header"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
            android:textColor="@color/ds_on_surface" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_journey_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_badge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_journey_all_badges"
            style="@style/Widget.Sakhi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/journey_view_all_badges" />
    </LinearLayout>
</ScrollView>
