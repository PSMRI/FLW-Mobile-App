<?xml version="1.0" encoding="utf-8"?>
<!--
    General check-up list card · redesign (Figma list card pattern): initials + name + age (adapter); relation / gender,
    ben ID / mobile, earlier check-ups; Add check-up (filled). GcCardLabel/Value styles replaced by Sakhi.Info*.
    Ids unchanged (+ tv_ds_initials). Old layout: legacy_rv_item_general_checkup.xml.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sakhi.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ds_space_md"
    android:layout_marginTop="@dimen/ds_space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingTop="@dimen/ds_space_sm"
        android:paddingBottom="@dimen/ds_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ds_pill"
                android:backgroundTint="@color/ds_primary_container">

                <TextView
                    android:id="@+id/tv_ds_initials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                    android:textColor="@color/ds_on_primary_container"
                    tools:text="RY" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_ben_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    tools:text="Ramlal Yadav" />

                <TextView
                    android:id="@+id/tv_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    tools:text="67 Years 3 Months" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Sakhi.InfoCell"
                    android:layout_marginEnd="@dimen/ds_space_xs">

                    <TextView
                        android:id="@+id/tv_relation_label"
                        tools:text="Father Name"
                        style="@style/Sakhi.InfoLabel" />

                    <TextView
                        android:id="@+id/tv_relation_name"
                        style="@style/Sakhi.InfoValue" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Sakhi.InfoCell">

                    <TextView
                        android:text="@string/gender"
                        style="@style/Sakhi.InfoLabel" />

                    <TextView
                        android:id="@+id/tv_gender"
                        style="@style/Sakhi.InfoValue" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Sakhi.InfoCell"
                    android:layout_marginEnd="@dimen/ds_space_xs">

                    <TextView
                        android:text="@string/beneficiary_id"
                        style="@style/Sakhi.InfoLabel" />

                    <TextView
                        android:id="@+id/tv_ben_id"
                        style="@style/Sakhi.InfoValue" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Sakhi.InfoCell">

                    <TextView
                        android:text="@string/mobile_number"
                        style="@style/Sakhi.InfoLabel" />

                    <TextView
                        android:id="@+id/tv_mobile"
                        style="@style/Sakhi.InfoValue" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Sakhi.InfoCell"
                    android:layout_marginEnd="@dimen/ds_space_xs">

                    <TextView
                        android:text="@string/gc_earlier_checkups"
                        style="@style/Sakhi.InfoLabel" />

                    <TextView
                        android:id="@+id/tv_checkup_count"
                        style="@style/Sakhi.InfoValue" />
                </LinearLayout>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_checkup"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/gc_add_checkup"
            app:icon="@drawable/ic_ds_add"
            app:iconGravity="textStart" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
