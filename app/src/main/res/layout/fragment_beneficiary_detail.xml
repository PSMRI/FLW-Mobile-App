<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">
    <!-- Trainer / ANM claim review (Mitanin incentive verification) · redesign (row 26), ds tokens on the existing structure:
         surface bg, info banner = Figma banner (primary-subtle r12, padding 12/16, 20dp info icon, 14/20 text), claims card =
         white r16 1dp #DCE1E8 without shadow, table head in #EEF1F5 with 12/16 Medium labels, summary / empty text in the variant
         colour, rejection sheet = white r24 card, title 22/28, 56dp reason box (r12), 48dp error-coloured pill to confirm.
         Ids unchanged. Old layout: legacy_fragment_beneficiary_detail.xml. -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/ds_primary"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- BRD §19.4: actions live on each row, so tell the reviewer how to use them -->
            <LinearLayout
                android:id="@+id/infoBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_marginTop="@dimen/ds_space_md"
                android:layout_marginEnd="@dimen/ds_space_md"
                android:background="@drawable/bg_ds_banner_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_md"
                android:paddingTop="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_md"
                android:paddingBottom="@dimen/ds_space_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_info"
                    app:tint="@color/ds_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:text="@string/approve_or_reject_row_hint"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                    android:textColor="@color/ds_on_surface" />

            </LinearLayout>

            <!-- Activity header + its claimed records, as one card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardClaims"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:layout_marginEnd="@dimen/ds_space_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/infoBanner">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header. Not part of the RecyclerView, so it mirrors layout_mt_inner's
                         columns by hand: the same actions spacer, the same fixed S.No width and
                         the same margins, all from @dimen/mt_row_*. Guidelines were used before
                         and put "S. No" over the tick/cross icons with the title 50dp left of the
                         name it labels. -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/llHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/ds_surface_container_high"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <!-- Reserves the row's tick/cross column; hidden with them on read-only rows -->
                        <Space
                            android:id="@+id/spaceHeaderActions"
                            android:layout_width="@dimen/mt_row_action_column"
                            android:layout_height="1dp"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvHeaderSerialNo"
                            android:layout_width="@dimen/mt_row_serial_width"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/mt_row_serial_margin"
                            android:gravity="center"
                            android:text="@string/s_no"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                            android:textColor="@color/ds_on_surface_variant"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/spaceHeaderActions"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_goneMarginStart="@dimen/mt_row_serial_margin" />

                        <TextView
                            android:id="@+id/tvActivityHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/mt_row_info_margin"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                            android:textColor="@color/ds_on_surface_variant"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/tvHeaderAmount"
                            app:layout_constraintStart_toEndOf="@id/tvHeaderSerialNo"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Attending monthly cluster meetings of Mitanins" />

                        <TextView
                            android:id="@+id/tvHeaderAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                            android:textColor="@color/ds_on_surface_variant"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="₹150" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBeneficiaries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"
                        tools:itemCount="3"
                        tools:listitem="@layout/layout_mt_inner"
                        tools:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "<count> · <total>" under the card -->
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                android:textColor="@color/ds_on_surface_variant"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardClaims"
                tools:text="1 · ₹150"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/no_beneficiaries_found"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                android:textColor="@color/ds_on_surface_variant"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSummary" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#730F141A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:cardBackgroundColor="@color/ds_surface_container"
            app:cardCornerRadius="@dimen/ds_radius_xl"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reason_for_rejection"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
                        android:textColor="@color/ds_on_surface" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_rejected" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRejectionReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    tools:itemCount="7"
                    tools:listitem="@layout/item_rejection_reason" />

                <LinearLayout
                    android:id="@+id/otherReasonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etOtherReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_ds_field_box"
                        android:hint="Please provide the reason"
                        android:minHeight="56dp"
                        android:maxLength="250"
                        android:paddingHorizontal="@dimen/ds_space_md"
                        android:paddingVertical="@dimen/ds_space_sm"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:textColorHint="@color/ds_on_surface_variant" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmRejection"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xl"
                    android:text="@string/confirm_rejection"
                    app:backgroundTint="@color/ds_error" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
