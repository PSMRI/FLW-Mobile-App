<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.12-03 / -04 "ASHA monthly detail" + "Reject with reason" — worker lines 12/16, summary stat tiles
     (care / couple tones r16), info banner, table head (#EEF1F5, 12/16 Medium; guidelines match item_activity), activity
     rows, checkbox-option confirmation, Reject (outlined) + Verify (filled) 48dp pills; reject reasons in a bottom sheet
     (white r24 top, scrim). Old layout: legacy_fragment_worker_detail.xml. Ids unchanged. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kept for its id (navigation click is set in code); hidden like before -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface" />

                <TextView
                    android:id="@+id/tvWorkerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant" />

                <TextView
                    android:id="@+id/tvSupervisorInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/supervisor_id"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    android:visibility="gone" />

                <!-- Figma "Summary": stat tiles r16, padding 12, gap 8 -->
                <LinearLayout
                    android:id="@+id/summaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/monthly_summary"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ds_stat"
                            android:backgroundTint="@color/ds_module_care_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvClaimsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                                android:textColor="@color/ds_module_care_fg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/activity_claimed"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                                android:textColor="@color/ds_on_surface" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ds_stat"
                            android:backgroundTint="@color/ds_module_couple_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvTotalAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹1,600"
                                android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                                android:textColor="@color/ds_module_couple_fg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/total_claimed_amount"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                                android:textColor="@color/ds_on_surface" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Figma "Banner" Info -->
                <LinearLayout
                    android:id="@+id/tthcheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_ds_banner_info"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_info"
                        app:tint="@color/ds_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/verify_will_commit_every_activity_listed_below_in_one_action"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/no_activities_found"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                    android:textColor="@color/ds_on_surface_variant"
                    android:visibility="gone" />

                <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ds_table_head"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <!-- Guideline percentages must match item_activity.xml or the headers stop
                     sitting above their own column. -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline50"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.55" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline75"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.75" />

                <!-- FLW-1171: reserves the row's checkbox column so S.No and Activity keep
                     sitting above their values. Shown only when the rows carry checkboxes. -->
                <Space
                    android:id="@+id/spaceHeaderSelection"
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHeaderSerialNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="24dp"
                    android:text="@string/incentive_header_serial_no"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                    android:textColor="@color/ds_on_surface_variant"
                    app:layout_constraintStart_toEndOf="@id/spaceHeaderSelection"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvHeaderActivity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/incentive_header_activity"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:layout_marginStart="6dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                    android:textColor="@color/ds_on_surface_variant"
                    app:layout_constraintStart_toEndOf="@id/tvHeaderSerialNo"
                    app:layout_constraintEnd_toStartOf="@id/guideline50"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvHeaderCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/incentive_header_no_of_claims"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                    android:textColor="@color/ds_on_surface_variant"
                    app:layout_constraintStart_toStartOf="@id/guideline50"
                    app:layout_constraintEnd_toStartOf="@id/guideline75"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvHeaderAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/incentive_header_amount_claimed"
                    android:gravity="center"
                    android:paddingEnd="0dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                    android:textColor="@color/ds_on_surface_variant"
                    app:layout_constraintStart_toStartOf="@id/guideline75"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActivities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_activity" />

                <!-- Verification: checkbox option + Reject / Verify -->
                <LinearLayout
                    android:id="@+id/cvMain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbVerifyDocuments"
                        style="@style/Widget.Sakhi.CheckboxOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:text="@string/i_have_verified_supporting_documents_on_asha_s_device" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReject"
                            style="@style/Widget.Sakhi.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/reject" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerify"
                            style="@style/Widget.Sakhi.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/verify" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Already decided: success strip at the bottom -->
        <LinearLayout
            android:id="@+id/layoutVerified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_success_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ds_check_circle"
                app:tint="@color/ds_success" />

            <TextView
                android:id="@+id/role"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/verified_by"
                android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                android:textColor="@color/ds_success" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible"
        app:indicatorColor="@color/ds_primary" />

    <!-- Reject with reason: scrim + bottom sheet -->
    <FrameLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#730F141A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_ds_sheet_top_r24"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reason_for_rejection"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
                    android:textColor="@color/ds_on_surface" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgCancel"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ds_close"
                    android:padding="10dp"
                    android:src="@drawable/ic_ds_close"
                    app:tint="@color/ds_on_surface_variant" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRejectionReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:itemCount="4"
                tools:listitem="@layout/item_rejection_reason" />

            <LinearLayout
                android:id="@+id/otherReasonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etOtherReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_field_box"
                    android:gravity="top|start"
                    android:hint="Please provide the reason"
                    android:minHeight="96dp"
                    android:padding="16dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                    android:textColor="@color/ds_on_surface"
                    android:textColorHint="@color/ds_on_surface_variant" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmRejection"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/ds_error"
                android:text="@string/confirm_rejection" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
