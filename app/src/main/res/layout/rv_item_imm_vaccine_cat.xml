<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="category"
            type="org.piramalswasthya.sakhi.model.VaccineCategoryDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.ImmunizationCategoryAdapter.ImmunizationIconClickListener" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/ds_space_md">
        <!-- Redesign: category = section title 14/20 grey with 16dp side gutter; rows are full-width cards. Old: legacy_rv_item_imm_vaccine_cat.xml -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ds_space_md"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
            android:textColor="@color/ds_on_surface_variant"
            android:text="@{category.categoryString}"
            tools:text="Category ABCC" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_vaccine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="10"
            tools:listitem="@layout/rv_item_imm_vaccine" />
       <!-- android:orientation="horizontal"
        android:clipToPadding="false"-->

    </LinearLayout>


</layout>