<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_maameeting_item · redesign.
    Generated by design/redesign-tools/convert_simple_card.py (redesign card: title + icons, label/value grid, tonal action).
    Every TextView / ImageView / Button id, binding and click is kept. Old layout: legacy_layout_maameeting_item.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <data>
        <variable
            name="maaMeeting"
            type="org.piramalswasthya.sakhi.model.MaaMeetingEntity" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.MaaMeetingAdapter.MaaMeetingAdapterClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ll_title_ec_bar"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    android:id="@+id/tvDate"
                    app:formattedMeetingDate="@{maaMeeting.meetingDate}"
                    tools:text="Date" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:id="@+id/iv_miss_state"
                    android:visibility="invisible"
                    android:contentDescription="@string/iv_sync_state_tv"
                    android:src="@drawable/ic_women" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:id="@+id/iv_sync_state"
                    android:contentDescription="@string/iv_sync_state_tv"
                    app:syncState="@{maaMeeting.syncState}"
                    tools:src="@drawable/cloud_upload" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/meeting_date" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{maaMeeting.meetingDate != null ? maaMeeting.meetingDate : &quot;&quot;}"
                            tools:text="0" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/place" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{maaMeeting.place != null ? maaMeeting.place : &quot;&quot;}"
                            tools:text="HWC" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/participants" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{maaMeeting.participants != null ? String.valueOf(maaMeeting.participants) : &quot;&quot;}"
                            tools:text="0" />
                    </LinearLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:gravity="end"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Sakhi.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnView"
                    android:onClick="@{() -> clickListener.onClick(maaMeeting.id)}"
                    android:text="@string/ds_view" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
