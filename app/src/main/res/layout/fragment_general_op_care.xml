<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    tools:context=".ui.home_activity.all_household.AllHouseholdFragment">

    <!-- Redesign: 52dp pill search (same as the household / beneficiary lists); ids unchanged -->
    <LinearLayout
        android:id="@+id/ll_search"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_md"
        android:layout_marginEnd="@dimen/ds_space_md"
        android:background="@drawable/bg_ds_search_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_xs"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:drawableStart="@drawable/ic_ds_search"
            android:drawablePadding="@dimen/ds_space_sm"
            android:drawableTint="@color/ds_on_surface_variant"
            android:hint="@string/household_search"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
            android:textColor="@color/ds_on_surface"
            android:textColorHint="@color/ds_on_surface_variant" />

        <androidx.cardview.widget.CardView
            android:id="@+id/ib_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/ds_space_xs"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ib_search_im"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/household_search"
                android:src="@drawable/ic_ds_mic"
                app:tint="@color/ds_on_surface_variant"
                tools:visibility="visible" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_any"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_small"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search"
        tools:itemCount="2"
        tools:listitem="@layout/rv_item_household" />

    <FrameLayout
        android:id="@+id/fl_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search">

        <TextView
            android:id="@+id/tv_empty_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/padding_normal"
            android:text="@string/no_records_found"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </FrameLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
