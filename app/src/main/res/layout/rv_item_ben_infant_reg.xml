<?xml version="1.0" encoding="utf-8"?>
<!--
    Newborn (infant) registration card · redesign (same card pattern): initials + baby name + "Mother: name · age"
    (adapter) + sync badge; mother's ben ID / mobile / RCH ID; Register (filled) / View (tonal).
    Every id, binding and click is kept. Old layout: legacy_rv_item_ben_infant_reg.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />

        <import type="android.content.Context"/>

        <variable
            name="context"
            type="Context" />
        <variable
            name="item"
            type="org.piramalswasthya.sakhi.model.InfantRegDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.InfantRegistrationAdapter.ClickListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_ec_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <LinearLayout
                android:id="@+id/ll_title_ec_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{item.getCustomName(context)}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_ec_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{item.getCustomName(context)}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface" />

                    <LinearLayout
                        android:id="@+id/ll_ben_ec_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/iv_sync_state"
                    style="@style/Sakhi.Badge"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:contentDescription="@string/iv_sync_state_tv"
                    dsSyncBadge="@{item.syncState}"
                    tools:text="Synced" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_ec_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_ben_ec_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            dsBenIdText="@{item.motherBen.benId}" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_mob_no_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{item.motherBen.mobileNo}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_rch_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(item.motherBen.rchId == null || item.motherBen.rchId.empty) ? @string/ds_empty_value : item.motherBen.rchId}" />
                    </LinearLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_form_ec1"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:onClick="@{()-> clickListener.onClickForm(item)}"
                    android:text="@string/register"
                    android:minWidth="104dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
