<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    tools:context=".ui.home_activity.all_household.AllHouseholdFragment">
    <!-- Redesign (Figma 06 · All beneficiaries): surface bg, pill search bar with icon actions, cards scroll under an
         extended-FAB style bottom-end button. Ids unchanged; old layout: legacy_fragment_display_search_and_toggle_rv_button.xml.
         Not built (need logic): filter chips All / Women / Children / No ABHA, top-bar subtitle "N people · N not synced". -->

    <!-- Search bar · Figma 06 · All beneficiaries › "Search bar": 52dp pill #EEF1F5, 24dp icons in #42474E.
         The download / filter / mic actions sit inside the pill as icon buttons (Figma shows filter + mic). -->
    <LinearLayout
        android:id="@+id/ll_search"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_md"
        android:layout_marginEnd="@dimen/ds_space_md"
        android:background="@drawable/bg_ds_search_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_xs"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:drawableStart="@drawable/ic_ds_search"
            android:drawablePadding="@dimen/ds_space_sm"
            android:drawableTint="@color/ds_on_surface_variant"
            android:hint="@string/household_search"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
            android:textColor="@color/ds_on_surface"
            android:textColorHint="@color/ds_on_surface_variant" />

        <androidx.cardview.widget.CardView
            android:id="@+id/ib_download"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ib_download_im"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/ds_download_list"
                android:src="@drawable/ic_ds_download"
                app:tint="@color/ds_on_surface_variant" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/ib_filter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ib_filter_im"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/ds_filter"
                android:src="@drawable/ic_ds_filter_list"
                app:tint="@color/ds_on_surface_variant" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/ib_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ib_search_im"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/household_search"
                android:src="@drawable/ic_ds_mic"
                app:tint="@color/ds_on_surface_variant" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/filterText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:gravity="end"
        app:layout_constraintTop_toBottomOf="@+id/ll_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSelectedFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/md_theme_light_shadow" />

        <ImageView
            android:id="@+id/ivFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_25sdp"
            android:minHeight="@dimen/_25sdp"
            android:src="@drawable/ic_filter"
            android:tint="?attr/colorPrimary"
            android:layout_marginEnd="@dimen/_10sdp"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_any"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filterText"
        tools:itemCount="2"
        tools:listitem="@layout/rv_item_ben" />

    <FrameLayout
        android:id="@+id/fl_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filterText">

        <TextView
            android:id="@+id/tv_empty_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/padding_normal"
            android:text="@string/no_records_found"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </FrameLayout>


    <!-- Figma "FAB extended": 56dp, r16, primary, 16dp from the end, 24dp from the bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next_page"
        style="@style/Widget.Sakhi.Fab.Extended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_md"
        android:layout_marginEnd="@dimen/ds_space_md"
        android:layout_marginBottom="@dimen/ds_space_xl"
        android:text="@string/btn_text_frag_home_nhhr"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
