<?xml version="1.0" encoding="utf-8"?>
<!--
  One badge per page, laid out as a row so the card stays short on a phone: the
  stacked version spent most of the first screen on a single badge. Artwork on the
  left, then name, where she stands ("3 of 6", streak, level) and the bar showing
  how much of the next milestone is done.
  Redesign: Figma M2.1-01 "Badge progress row" — 44dp medal, gap 12, name 14/20 Medium, 6dp progress bar (r3),
  detail 12/16; on a white r16 card. Old layout: legacy_item_badge_carousel.xml. Ids unchanged.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sakhi.Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/iv_carousel_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/badge_shelf_title"
            android:scaleType="centerInside"
            tools:src="@drawable/badge_steady_syncer_t1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_carousel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                android:textColor="@color/ds_on_surface"
                tools:text="Steady Syncer" />

            <ProgressBar
                android:id="@+id/pb_carousel_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:progressDrawable="@drawable/bg_ds_progress_track"
                tools:progress="50" />

            <TextView
                android:id="@+id/tv_carousel_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                android:textColor="@color/ds_on_surface_variant"
                tools:text="Level 2 · 3 of 6 · 2 week streak" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
