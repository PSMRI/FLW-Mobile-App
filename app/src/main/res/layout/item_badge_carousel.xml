<?xml version="1.0" encoding="utf-8"?>
<!--
  One badge per page, laid out as a row so the card stays short on a phone: the
  stacked version spent most of the first screen on a single badge. Artwork on the
  left, then name, where she stands ("3 of 6", streak, level) and the bar showing
  how much of the next milestone is done.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#F2F9F7"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_normal"
        android:paddingVertical="@dimen/padding_small">

        <ImageView
            android:id="@+id/iv_carousel_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/badge_shelf_title"
            android:scaleType="centerInside"
            tools:src="@drawable/badge_steady_syncer_t1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_normal"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_carousel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Steady Syncer" />

            <TextView
                android:id="@+id/tv_carousel_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="🏅 Level 2 · 3 of 6 · 2 week streak" />

            <ProgressBar
                android:id="@+id/pb_carousel_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:progress="50" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
