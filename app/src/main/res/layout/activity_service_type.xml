<?xml version="1.0" encoding="utf-8"?>
<!--
    Choose work location · redesign, matched to Figma "FLW App Redesign" › 2.13 › M2.13-04 (spec dumped from the file):
    top bar 64dp (title 22/28, subtitle 12/16), content padding 16, 12dp between fields, read-only fields with "Auto"
    pill (Block is read-only in code, per the M2.11-29 rule), Village dropdown, info banner, bottom action bar.
    Only the look changed: all ids used by ServiceLocationActivity are kept (tv_state / tv_district / tv_block are read
    in dataValid(); they hold the value, "—" when empty, so never blank). Old layout: legacy_activity_service_type.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.service_location_activity.ServiceLocationActivity">

    <data>
        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="org.piramalswasthya.sakhi.ui.service_location_activity.ServiceTypeViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- Top app bar (Home type, no actions) -->
        <LinearLayout
            android:id="@+id/cv_login_item_container"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_space_md"
            android:paddingEnd="@dimen/ds_space_xs">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ds_where_work_today"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
                android:textColor="@color/ds_on_surface" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ds_change_later_profile"
                android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                android:textColor="@color/ds_on_surface_variant" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_md">

                <!-- Read-only: service_type_dd_state_text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/service_type_dd_state_text"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_on_surface_variant" />

                        <TextView
                            style="@style/Widget.Sakhi.AutoPill"
                            android:text="@string/ds_auto" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/ds_space_2xs"
                        android:background="@drawable/bg_ds_readonly_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/ds_space_md">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_state"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{viewModel.stateDropdownEntry.isEmpty() ? @string/ds_empty_value : viewModel.stateDropdownEntry}"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                            android:textColor="@color/ds_on_surface"
                            tools:text="Assam" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="@dimen/ds_space_xs"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ds_lock"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Read-only: service_type_dd_district_text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/service_type_dd_district_text"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_on_surface_variant" />

                        <TextView
                            style="@style/Widget.Sakhi.AutoPill"
                            android:text="@string/ds_auto" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/ds_space_2xs"
                        android:background="@drawable/bg_ds_readonly_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/ds_space_md">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_district"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{viewModel.districtDropdownEntry.isEmpty() ? @string/ds_empty_value : viewModel.districtDropdownEntry}"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                            android:textColor="@color/ds_on_surface"
                            tools:text="Kamrup" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="@dimen/ds_space_xs"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ds_lock"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Read-only: service_type_dd_block_text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/service_type_dd_block_text"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_on_surface_variant" />

                        <TextView
                            style="@style/Widget.Sakhi.AutoPill"
                            android:text="@string/ds_auto" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/ds_space_2xs"
                        android:background="@drawable/bg_ds_readonly_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/ds_space_md">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_block"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{viewModel.blockDropdownEntry.isEmpty() ? @string/ds_empty_value : viewModel.blockDropdownEntry}"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                            android:textColor="@color/ds_on_surface"
                            tools:text="Rajnagar" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="@dimen/ds_space_xs"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ds_lock"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Read-only: ds_label_facility -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:orientation="vertical"
                    android:visibility="@{viewModel.facilityName.isEmpty() ? View.GONE : View.VISIBLE}">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ds_label_facility"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_on_surface_variant" />

                        <TextView
                            style="@style/Widget.Sakhi.AutoPill"
                            android:text="@string/ds_auto" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/ds_space_2xs"
                        android:background="@drawable/bg_ds_readonly_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/ds_space_md">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_facility"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{viewModel.facilityName}"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                            android:textColor="@color/ds_on_surface"
                            tools:text="HSC Sirsi" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="@dimen/ds_space_xs"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ds_lock"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- old helper line, not in the design -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_select_service_region"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_text_select_village"
                    android:visibility="gone" />

                <!-- Village * (the only choice) -->
                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:labelFor="@id/actv_village_dropdown"
                    android:text="@string/ds_village_required" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_village_dropdown"
                    style="@style/Widget.Sakhi.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actv_village_dropdown"
                        listItems="@{viewModel.villageList}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Village Dropdown"
                        android:importantForAccessibility="yes"
                        android:inputType="none"
                        android:minHeight="56dp"
                        android:paddingHorizontal="@dimen/ds_space_md"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Info banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:background="@drawable/bg_ds_banner_info"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/ds_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ds_assigned_villages_title"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_on_surface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ds_assigned_villages_body"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom action bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_bottom_bar"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingVertical="@dimen/ds_space_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_continue"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/ds_continue_to_app" />
        </FrameLayout>
    </LinearLayout>
</layout>
