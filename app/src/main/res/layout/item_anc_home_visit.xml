<?xml version="1.0" encoding="utf-8"?>
<!--
    ANC home-visit row in the "ANC home visits" sheet · redesign (row 26), same as rv_item_pregnancy_anc (Figma M2.2-29): title 16/24,
    sync badge, View tonal button (sentence case), hairline between rows. The old sync icon (ImageView + syncState) is now the
    ds sync badge (dsSyncBadge); ids, bindings and clicks unchanged. Old layout: legacy_item_anc_home_visit.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="visit"
            type="org.piramalswasthya.sakhi.model.HomeVisitDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.AncHomeVisitAdapter.HomeVisitClickListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingVertical="@dimen/ds_space_xs">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_visit_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{@string/home_visit_number(visit.visitNumber)}"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    tools:text="Home Visit 1" />

                <TextView
                    android:id="@+id/tv_visit_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{visit.visitDateString}"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    android:visibility="gone"
                    tools:text="12 Dec 2023" />
            </LinearLayout>

            <TextView
                android:id="@+id/iv_sync_state"
                style="@style/Sakhi.Badge"
                android:layout_marginHorizontal="@dimen/ds_space_xs"
                android:contentDescription="@string/sync_status"
                dsSyncBadge="@{visit.syncState}"
                tools:text="Synced" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view"
                style="@style/Widget.Sakhi.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_view" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/ds_space_md"
            android:background="@color/ds_outline_variant" />
    </LinearLayout>
</layout>
