<?xml version="1.0" encoding="utf-8"?>
<!--
    Adolescent health card · redesign (Figma list card pattern): initials + name + age (adapter) + consent icon + sync badge;
    ben ID / mobile, RCH ID / gender, registration date, father / husband / spouse (adapter picks one); Register (filled)
    / View (tonal) set in AdolescentHealthListAdapter. Every id, binding and click is kept.
    Old layout: legacy_rv_item_adolscent_health_list.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="org.piramalswasthya.sakhi.BuildConfig" />

        <variable
            name="ben"
            type="org.piramalswasthya.sakhi.model.BenWithAdolescentDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.AdolescentHealthListAdapter.ClickListener" />

        <variable
            name="showAbha"
            type="Boolean" />

        <variable
            name="showSyncIcon"
            type="Boolean" />

        <variable
            name="hasAbha"
            type="Boolean" />

        <variable
            name="showRegistrationDate"
            type="Boolean" />
        <variable
            name="father"
            type="Boolean" />
        <variable
            name="husband"
            type="Boolean" />
        <variable
            name="spouse"
            type="Boolean"/>

        <variable
            name="role"
            type="Integer" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <LinearLayout
                android:id="@+id/ll_title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{ben.ben.benFullName}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{ben.ben.benFullName}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface" />

                    <LinearLayout
                        android:id="@+id/ll_title_bar_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:contentDescription="@null"
                    android:src="@{ben.ben.isConsent ? @drawable/verified : @drawable/not_verified}"
                    android:visibility="@{BuildConfig.FLAVOR.contains(&quot;mitanin&quot;) ? View.GONE : View.VISIBLE}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_new_ben"
                    style="@style/Widget.Sakhi.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_rv_item_hh_add_ben"
                    android:visibility="gone" />

                <!-- kept for the adapter (was the empty grid cell next to RCH ID) -->
                <View
                    android:id="@+id/blank_space"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/iv_sync_state"
                    style="@style/Sakhi.Badge"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:contentDescription="@string/iv_sync_state_tv"
                    dsSyncBadge="@{ben.adolescent.syncState}"
                    tools:text="Synced" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_tb_screening_list_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_ben_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            dsBenIdText="@{ben.ben.benId}" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/mob"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/mobile_number" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.ben.mobileNo}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_ben_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        rchId="@{ben.ben}"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/rch_id_ben" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(ben.ben.rchId == null || ben.ben.rchId.empty) ? @string/ds_empty_value : ben.ben.rchId}" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/gender" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            app:localizedGender="@{ben.ben.gender}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_ben_details_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/registration_date"
                        showLayout="@{showRegistrationDate}"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/registration_date" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.ben.regDate}" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/ncd_father_name"
                        showLayout="@{father}"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_father_name_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.ben.fatherName}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ncd_husband_name"
                        showLayout="@{husband}"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_husband_name_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.ben.spouseName}" />
                    </LinearLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ncd_spouse_name"
                        showLayout="@{spouse}"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_spouse_name_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{ben.ben.spouseName}" />
                    </LinearLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_form_tb"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:onClick="@{()-> clickListener.onClickForm(ben)}"
                    android:text="@string/register"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
