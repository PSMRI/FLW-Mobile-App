<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.10-05 "Verify mobile OTP" — steps (Mobile current), message 14/20, OTP boxes 44×52, wait text, text button "Resend OTP", bottom bar Exit (after lock-out) + Verify OTP. Old layout: legacy_fragment_verify_mobile_otp.xml. All view ids unchanged. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface">

        <LinearLayout
            android:id="@+id/cl_verify_mobile_otp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <include layout="@layout/layout_ds_abha_steps" />

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/verify_aadhaar_number"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    android:visibility="gone" />

                <!-- "OTP sent to … ending with **1234" 14/20 -->
                <TextView
                    android:id="@+id/tv_otp_msg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/otp_sent_to"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                    android:textColor="@color/ds_on_surface"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/dummyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ds_abha_enter_otp"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    android:visibility="gone" />

                <!-- Kept for its id; the heading above replaces it -->
                <TextView
                    android:id="@+id/tvLblEnterOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_enter_otp"
                    android:visibility="gone" />

                <!-- Figma "OTP": 6 boxes 44×52, gap 8, r12, 1dp outline (current box primary), digits 22/28 -->
                <org.piramalswasthya.sakhi.helpers.otpview.PinView
                    android:id="@+id/otpView"
                    style="@style/PinWidget.PinView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:cursorVisible="true"
                    android:fontFamily="@font/roboto_medium"
                    android:inputType="number"
                    android:itemBackground="@color/ds_surface_container"
                    android:textColor="@color/ds_on_surface"
                    android:textSize="22sp"
                    app:cursorColor="@color/ds_primary"
                    app:hideLineWhenFilled="false"
                    app:itemCount="6"
                    app:itemHeight="52dp"
                    app:itemRadius="12dp"
                    app:itemSpacing="8dp"
                    app:itemWidth="44dp"
                    app:lineColor="@color/ds_pin_line"
                    app:lineWidth="1dp" />

                <TextView
                    android:id="@+id/tv_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/textview"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_error"
                    android:visibility="gone" />

                <!-- "Didn't receive OTP? Please wait 42 seconds" 12/16 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timer_resend_otp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_didnt_receive_otp"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface_variant" />

                    <TextView
                        android:id="@+id/timer_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/_30"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant" />

                    <TextView
                        android:id="@+id/timer_seconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_seconds"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface_variant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOTPNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_ds_timer"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/str_abha_otp_note"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    android:visibility="invisible"
                    app:drawableTint="@color/ds_on_surface_variant" />

                <!-- Figma: text button "Resend OTP" (48dp) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resend_otp"
                    style="@style/Widget.Sakhi.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/resend_otp" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Figma "Bottom action bar": white, 1dp top border, padding 12/16, gap 12; Exit only after a lock-out -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ds_bottom_bar"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exit"
                    style="@style/Widget.Sakhi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/exit"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_verify_OTP"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/verify_otp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pb_vmotp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ds_primary" />

        <!-- Offline: Figma "Empty state" (M2.10-07) -->
        <LinearLayout
            android:id="@+id/cl_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            android:paddingTop="48dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_ds_empty_illustration">

                <ImageView
                    android:id="@+id/iv_offline"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/offline"
                    android:src="@drawable/ic_ds_wifi_off"
                    app:tint="@color/ds_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/something_went_wrong_nunable_to_connect_to_server_ntry_again_later"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                android:textColor="@color/ds_on_surface_variant" />
        </LinearLayout>
    </FrameLayout>
