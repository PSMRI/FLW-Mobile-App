<?xml version="1.0" encoding="utf-8"?>
<!--
    Monthly Recap dashboard card - ONE reusable layout for every visible state
    (READY / RESUME / REPLAY). State differences are applied at runtime through
    content + visibility (see HomeIconsFragment#renderMonthlyRecapStrip), never
    through separate layouts.

    Design: not a band of brand colour. The surface is the same ivory-to-lilac wash
    as the recap playback screen, so tapping the card feels like stepping into the
    story rather than opening an unrelated screen. The ASHA-didi is the only
    saturated element and stands on the base of the card.

    Kept deliberately short. The card sits above the icon grid, so it must not own
    the screen: the character is the tallest thing in it, one line of message, and
    the CTA is a text + chevron rather than a filled pill (the whole card is the
    click target anyway, so the pill was affordance the card did not need). No
    stroke - a hairline on a light card over a light page only muddies the corners;
    a single dp of elevation separates it cleanly.

    Accessibility: the whole card is a single click target. Its contentDescription is
    set per state in code and the content container is marked noHideDescendants, so
    the character, chips, progress and CTA are never separately focused and the CTA
    never creates a duplicate action.

    Privacy: no beneficiary names, health information, medical conditions or counts.
-->
<!-- Redesign: Figma M2.19-17 "Monthly recap strip" — white card r16, 1dp outline-variant, padding 16, gap 12: head
     (month + title 16/24 + NEW / done tags), 6dp progress (r3), message 12/16, CTA 14/20 primary. The animated didi is kept
     (code drives it) at 56dp. Old layout: legacy_monthly_recap_strip.xml. Ids unchanged. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sakhi.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/ds_primary_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Compact didi (not in Figma; kept because HomeIconsFragment animates it) -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/recap_character"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/recap_didi_dashboard" />

        <LinearLayout
            android:id="@+id/recap_text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Figma "Head": month · title · tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/recap_month_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    tools:text="June" />

                <TextView
                    android:id="@+id/recap_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/monthly_recap_title"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface" />

                <TextView
                    android:id="@+id/recap_badge_new"
                    style="@style/Sakhi.Tag"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/ds_success_container"
                    android:text="@string/monthly_recap_badge_new"
                    android:textColor="@color/ds_success"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/recap_badge_done"
                    style="@style/Sakhi.Tag"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/ds_surface_container_high"
                    android:text="@string/monthly_recap_badge_done"
                    android:textColor="@color/ds_on_surface_variant"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/recap_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressDrawable="@drawable/bg_ds_progress_track"
                android:visibility="gone"
                tools:progress="50"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/recap_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                android:textColor="@color/ds_on_surface_variant"
                tools:text="Your recap is ready — see the impact you made." />

            <TextView
                android:id="@+id/recap_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="@string/monthly_recap_view_recap"
                android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                android:textColor="@color/ds_primary"
                app:drawableTint="@color/ds_primary"
                tools:text="View Recap" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
