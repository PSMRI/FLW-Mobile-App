<?xml version="1.0" encoding="utf-8"?>
<!--
    TPT start / follow-up · redesign (row 26), Figma M2.7-30 "TPT start / follow-up" + the fragment_new_form shell: surface bg, the form
    list in a white section card (r16, 1dp #DCE1E8), "Follow-up history" 16/24 + the follow-up table, Submit = 48dp pill in a white
    bottom action bar (collapses when Submit is hidden), edit FAB in primary. Ids unchanged. Old layout: legacy_fragment_tpt_start.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/ds_space_md">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:indeterminateTint="@color/ds_primary"
                    android:visibility="gone" />

                <!-- Figma section card: white, r16, 1dp #DCE1E8; fields carry their own 16dp side padding -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Sakhi.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/ds_space_md">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingVertical="@dimen/ds_space_xs" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/followup_heading"
                    style="@style/Sakhi.G26.SectionTitle"
                    android:layout_marginHorizontal="@dimen/ds_space_md"
                    android:text="@string/follow_up_history"
                    android:visibility="gone" />

                <include
                    android:id="@+id/include_followup_table"
                    layout="@layout/layout_ncd_followup_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ds_space_md"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Figma "Bottom action bar": white, padding 12/16, 48dp pill (padding on the button so the bar collapses when it is hidden) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_bottom_bar"
            android:paddingHorizontal="@dimen/ds_space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/ds_space_sm"
                android:text="@string/submit" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/ds_space_md"
        android:layout_marginBottom="88dp"
        android:src="@drawable/ic_edit"
        android:visibility="gone"
        app:backgroundTint="@color/ds_primary"
        app:tint="@color/ds_on_primary" />
</FrameLayout>
