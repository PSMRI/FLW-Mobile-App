<?xml version="1.0" encoding="utf-8"?>
<!--
    Sub-centre row (supervisor incentive dashboard) · redesign (Figma list-row pattern, M2.11-09 "List item"):
    56dp min height, 24dp location icon #42474E, 12dp gap, name 14/20 Medium #191C1F, "ASHAs: N" 12/16 Medium primary,
    1dp #DCE1E8 divider under the row (hidden on the last row by SubCenterAdapter). Ids unchanged.
    Old layout: legacy_layout_list_item.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/str_subcenter"
        android:src="@drawable/baseline_location_on_24"
        app:layout_constraintBottom_toTopOf="@id/underLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ds_on_surface_variant" />

    <TextView
        android:id="@+id/subCenterName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_sm"
        android:layout_marginEnd="@dimen/ds_space_xs"
        android:paddingVertical="@dimen/ds_space_md"
        android:text="@string/str_subcenter"
        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
        android:textColor="@color/ds_on_surface"
        app:layout_constraintBottom_toTopOf="@id/underLine"
        app:layout_constraintEnd_toStartOf="@id/tvAshaCount"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAshaCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
        android:textColor="@color/ds_primary"
        app:layout_constraintBottom_toTopOf="@id/underLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="ASHAs: 0" />

    <View
        android:id="@+id/underLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ds_outline_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subCenterName" />

</androidx.constraintlayout.widget.ConstraintLayout>
