<?xml version="1.0" encoding="utf-8"?>
<!--
    PNC mothers list card · redesign (Figma M2.2-12 maternal lists, same card pattern as the ANC card):
    initials avatar + name + "W/o husband · age" (adapter) + sync badge; "No visit in last 3 months" tag;
    values (ben ID, mobile, RCH ID, delivery date, last visit); Add PNC (filled) + PNC visits (tonal).
    Every id, binding and click is kept. Old layout: legacy_rv_item_pnc_visit.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="visit"
            type="org.piramalswasthya.sakhi.model.BenPncDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.PncVisitListAdapter.PncVisitClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:id="@+id/ll_title_pwr_tracking_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{visit.ben.benFullName}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container"
                        tools:text="SD" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_ec_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{visit.ben.benFullName}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface"
                        tools:text="Sunita Devi" />

                    <LinearLayout
                        android:id="@+id/ll_ben_pwr_tracking_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant"
                            tools:text="W/o Ramesh · 26 Years" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/iv_sync_state"
                    style="@style/Sakhi.Badge"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:contentDescription="@string/iv_sync_state_tv"
                    dsSyncBadge="@{visit.syncState}"
                    tools:text="Synced" />
            </LinearLayout>

            <!-- ===== Tags ===== -->
            <TextView
                android:id="@+id/iv_follow_state"
                style="@style/Sakhi.Tag"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:backgroundTint="@color/ds_warning_container"
                android:text="@string/icon_title_no_follow_up"
                android:textColor="@color/ds_warning"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ===== Values ===== -->
            <LinearLayout
                android:id="@+id/linear_pwr_tracking_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_ben_pwr_tracking_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            dsBenIdText="@{visit.ben.benId}"
                            tools:text="674875273318" />
                    </LinearLayout>

                    <LinearLayout style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_mob_no_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{visit.ben.mobileNo}"
                            tools:text="8499845615" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_rch_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(visit.ben.rchId == null || visit.ben.rchId.empty) ? @string/ds_empty_value : visit.ben.rchId}"
                            tools:text="123456789012" />
                    </LinearLayout>

                    <LinearLayout style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/do_delivery_date" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(visit.deliveryDate == null || visit.deliveryDate.isEmpty()) ? @string/ds_empty_value : visit.deliveryDate}"
                            tools:text="02-10-2026" />
                    </LinearLayout>
                </LinearLayout>

                <!-- last visit (the adapter hides it until there is one); status / lmp cells kept for their ids -->
                <LinearLayout
                    android:id="@+id/ll_ben_pwr_tracking_details_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llVisitDate"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/last_visit_date" />

                        <TextView
                            android:id="@+id/benVisitDate"
                            style="@style/Sakhi.InfoValue"
                            tools:text="12-10-2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llBenStatus"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/benStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llLmpDate"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/benLmpDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Actions ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_pnc"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:onClick="@{() -> clickListener.addVisit(visit)}"
                    android:text="@string/add_pnc_visits" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_visits"
                    style="@style/Widget.Sakhi.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:onClick="@{() -> clickListener.showVisits(visit)}"
                    android:text="@string/pnc_visits" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
