<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign (form kit, Figma 07 · Register member): Government-official Aadhaar entry (hidden in the app today).
     Labels above 56dp boxes, gender as segmented options, filled 48dp button. Padding 16, gap 12.
     Old layout: legacy_fragment_aadhaar_number_gov.xml. All view ids unchanged. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/Widget.Sakhi.FieldLabel"
            android:layout_marginTop="12dp"
            android:text="@string/aadhaar_number" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_aadhaar_number"
            style="@style/Widget.Sakhi.TextField.Boxed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tiet_aadhaar_number"
                style="@style/Widget.Sakhi.TextField.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/aadhaar_number"
                android:inputType="number"
                android:maxLength="12" />
            <TextView
                android:id="@+id/tv_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/textview"
                android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                android:textColor="@color/ds_error"
                android:visibility="gone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Sakhi.FieldLabel"
            android:layout_marginTop="12dp"
            android:text="@string/full_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_full_name"
            style="@style/Widget.Sakhi.TextField.Boxed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tiet_full_name"
                style="@style/Widget.Sakhi.TextField.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/full_name"
                android:inputType="text" />
            <TextView
                android:id="@+id/tv_error_text_full_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/textview"
                android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                android:textColor="@color/ds_error"
                android:visibility="gone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Sakhi.FieldLabel"
            android:layout_marginTop="12dp"
            android:text="@string/d_o_b" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_text"
            style="@style/Widget.Sakhi.TextField.Boxed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/date_et"
                style="@style/Widget.Sakhi.TextField.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_calendar"
                android:focusable="false"
                android:hint="@string/d_o_b" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/ll_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Sakhi.FieldLabel"
                android:text="@string/tv_gender_ph" />

            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <org.piramalswasthya.sakhi.ui.design.DsCheckRadioButton
                    android:id="@+id/rb_male"
                    style="@style/Widget.Sakhi.SegmentedOption"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/male" />

                <org.piramalswasthya.sakhi.ui.design.DsCheckRadioButton
                    android:id="@+id/rb_female"
                    style="@style/Widget.Sakhi.SegmentedOption"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/female" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            style="@style/Widget.Sakhi.FieldLabel"
            android:layout_marginTop="12dp"
            android:text="@string/state" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_state_dn"
            style="@style/Widget.Sakhi.TextField.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/actv_state_dn"
                style="@style/Widget.Sakhi.TextField.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/state"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Sakhi.FieldLabel"
            android:layout_marginTop="12dp"
            android:text="@string/district" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_district_dn"
            style="@style/Widget.Sakhi.TextField.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/actv_district_dn"
                style="@style/Widget.Sakhi.TextField.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/district"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_abha"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/generate_abha" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
