<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.10-09 / -10 "Find ABHA by mobile" — heading 16/24, mobile box + tonal "Search" (48dp, gap 8),
     "Select ABHA" boxed dropdown + helper, confirmation as a checkbox option row, bottom action bar "Generate OTP".
     Padding 16, gap 12. Old layout: legacy_fragment_find_abha.xml. All view ids unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvFindOutAbha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/str_find_abha"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface" />

            <TextView
                android:id="@+id/tvGetAbha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/str_get_your_abha"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                android:textColor="@color/ds_on_surface_variant" />

            <!-- Mobile number + Search -->
            <TextView
                android:id="@+id/textView4"
                style="@style/Widget.Sakhi.FieldLabel"
                android:layout_marginTop="12dp"
                android:text="@string/enter_mobile_number" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_mobile_number"
                        style="@style/Widget.Sakhi.TextField.Boxed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tiet_mobile_number"
                            style="@style/Widget.Sakhi.TextField.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/mobile_number"
                            android:inputType="number"
                            android:maxLength="10"
                            android:paddingEnd="44dp"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageView
                        android:id="@+id/ivValidMobile"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle_grey" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search_abha"
                    style="@style/Widget.Sakhi.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:enabled="false"
                    android:paddingHorizontal="24dp"
                    android:text="@string/household_search" />
            </LinearLayout>

            <!-- Select ABHA -->
            <TextView
                style="@style/Widget.Sakhi.FieldLabel"
                android:layout_marginTop="12dp"
                android:text="@string/select_abha" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_select_abha"
                style="@style/Widget.Sakhi.TextField.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                app:hintEnabled="false">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/abha_dropdown"
                    style="@style/Widget.Sakhi.TextField.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:hint="@string/select_abha"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_error_text_abha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/textview"
                android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                android:textColor="@color/ds_error"
                android:visibility="gone" />

            <!-- Beneficiary name (hidden in the app today) -->
            <LinearLayout
                android:id="@+id/clBenName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textView6"
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:text="@string/enter_ben_name" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_ben_name"
                        style="@style/Widget.Sakhi.TextField.Boxed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tiet_ben_name"
                            style="@style/Widget.Sakhi.TextField.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/tv_ben_name_ph"
                            android:inputType="textCapWords"
                            android:paddingEnd="44dp"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tv_error_text_ben_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/textview"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_error"
                            android:visibility="gone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageView
                        android:id="@+id/ivValidBenName"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle_grey" />
                </FrameLayout>
            </LinearLayout>

            <!-- Figma "Consent": checkbox option row -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/aadharConsentCheckBox"
                style="@style/Widget.Sakhi.CheckboxOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/aadhar_consent_text"
                android:gravity="start|center_vertical"
                android:paddingVertical="12dp"
                android:text="@string/aadhar_consent_text" />

            <!-- "Tap to read the consent" link (invisible in the app today, as before) -->
            <TextView
                android:id="@+id/aadharDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aadhar_disclaimer_consent_disclaimer"
                android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                android:textColor="@color/ds_primary"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/pid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pid"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ds_bottom_bar"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_otp"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/generate_otp" />
    </FrameLayout>
</LinearLayout>
