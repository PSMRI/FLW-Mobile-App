<?xml version="1.0" encoding="utf-8"?>
<!--
    Dynamic form field row (FormRendererAdapter: HBNC / HBYC / campaigns / MDA / general check-up) · redesign
    (Figma 07 · Register member, "Text field"): label ABOVE 14/20 Medium #42474E, 4dp to the input, error text
    12/16 #BA1A1A, 16dp side padding, 8dp above/below. The inputs themselves are built in code (FormRendererAdapter).
    Ids unchanged; old layout: legacy_item_form_field.xml.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/ds_space_md"
    android:paddingVertical="@dimen/ds_space_xs">

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
        android:textColor="@color/ds_on_surface_variant"
        tools:text="Field Label" />

    <FrameLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2xs" />

    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/ds_space_2xs"
        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
        android:textColor="@color/ds_error"
        android:visibility="gone" />
</LinearLayout>
