<?xml version="1.0" encoding="utf-8"?>
<!--
    Section headline · redesign (Figma 07 › "Personal details" title): 16/24, on-surface; optional divider above
    (headingLine) in #DCE1E8; subtitle 14/20 #42474E; high-risk marker as a red tag.
    Ids and bindings unchanged; old layout: legacy_rv_item_form_headline_v2.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="form"
            type="org.piramalswasthya.sakhi.model.FormElement" />
    </data>

    <LinearLayout
        android:id="@+id/cl_highlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingTop="@dimen/ds_space_md"
        android:paddingBottom="@dimen/ds_space_xs">

        <com.google.android.material.divider.MaterialDivider
            headingLine="@{form.headingLine}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_md"
            app:dividerColor="@color/ds_outline_variant" />

        <LinearLayout
            android:id="@+id/ll_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{form.title}"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    tools:text="Personal details" />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{form.subtitle}"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                    android:textColor="@color/ds_on_surface_variant"
                    tools:text="Subtitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_high_risk"
                style="@style/Sakhi.Tag"
                android:layout_marginStart="@dimen/ds_space_xs"
                android:backgroundTint="@color/ds_error_container"
                android:text="@string/high_risk"
                android:textColor="@color/ds_error"
                app:required="@{form.showHighRisk}" />

            <ImageView
                android:id="@+id/check_red"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/ds_space_2xs"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle_red"
                app:imgRequired="@{form.showHighRisk}" />
        </LinearLayout>
    </LinearLayout>
</layout>
