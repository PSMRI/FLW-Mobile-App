<?xml version="1.0" encoding="utf-8"?>
<!--
    Upload chooser dialog · redesign (Figma M2.2-26 "Upload chooser · gallery / camera / PDF", M2.9-19 / M2.9-24):
    shown in a MaterialAlertDialog (white, r24 via ThemeOverlay.Sakhi.Dialog); 24dp padding, 16dp gap; 28dp primary
    upload icon, title 22/28 Medium, three 44dp option rows (24dp primary icon, 16dp gap, 16/24 label), Cancel text
    button at the end. Ids unchanged (Button → MaterialButton, only click / visibility used);
    old layout: legacy_layout_media_options.xml.
    Not built (needs data): per-field title ("Upload MCP card (front)") — the dialog is shared, so it says "Choose an option".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_dialog"
    android:divider="@drawable/ds_gap_8"
    android:orientation="vertical"
    android:padding="@dimen/ds_space_xl"
    android:showDividers="middle">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ds_cloud_upload"
        app:tint="@color/ds_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:layout_marginBottom="@dimen/ds_space_xs"
        android:text="@string/ds_g25_choose_option"
        android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
        android:textColor="@color/ds_on_surface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGallery"
        style="@style/Widget.Sakhi.G25.ChooserOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ds_g25_pick_gallery"
        app:icon="@drawable/ic_gallery" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCamera"
        style="@style/Widget.Sakhi.G25.ChooserOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ds_g25_open_camera"
        app:icon="@drawable/ic_camera" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPdf"
        style="@style/Widget.Sakhi.G25.ChooserOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ds_g25_pick_pdf"
        app:icon="@drawable/ic_document_attach" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Sakhi.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:text="@string/cancel" />

</LinearLayout>
