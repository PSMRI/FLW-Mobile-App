<?xml version="1.0" encoding="utf-8"?>
<!--
    Module tile · redesign, matched to Figma "FLW App Redesign" › 03 · Home – Modules › "Module tile":
    white card, 1dp #DCE1E8 border, r16, padding 16, 12dp gap; 48dp icon square (module tone, r12, 26dp icon) + chevron;
    title 14/20 Medium; count 12/16 Medium in the module colour. Grid gap 16 = 8dp margin per tile + 8dp list padding.
    Used by every module hub (IconGridAdapter). Ids, click and count bindings are unchanged.
    Old layout: legacy_rv_item_icon_grid.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="homeIcon"
            type="org.piramalswasthya.sakhi.model.Icon" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.IconGridAdapter.GridIconClickListener" />

        <variable
            name="scope"
            type="kotlinx.coroutines.CoroutineScope" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_icon"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ds_space_xs"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{()-> clickListener.onClicked(homeIcon)}"
        app:strokeColor="@{homeIcon.allowRedBorder ? @color/ds_error : @color/ds_outline_variant}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="142dp"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_md">

            <!-- Top: icon square … chevron -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView2"
                    dsModuleIcon="@{homeIcon.icon}"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ds_module_icon"
                    android:contentDescription="@string/cd_icon_grid_icon"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic__hh" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ds_on_surface_variant" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:ellipsize="end"
                android:labelFor="@id/imageView2"
                android:maxLines="3"
                dsTileTitle="@{homeIcon.title}"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_on_surface"
                tools:text="Households" />

            <TextView
                android:id="@+id/tv_count"
                dsModuleToneText="@{homeIcon.icon}"
                recordCount="@{homeIcon.count}"
                scope="@{scope}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                tools:text="248" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
