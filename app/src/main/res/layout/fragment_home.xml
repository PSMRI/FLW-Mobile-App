<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.home_activity.home.HomeFragment">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/ll_full_load_progress"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_home_viewpager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/ds_primary"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabMaxWidth="0dp"
                app:tabRippleColor="@color/ds_primary_subtle"
                app:tabSelectedTextColor="@color/ds_primary"
                app:tabTextAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                app:tabTextColor="@color/ds_on_surface_variant" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp2_home"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- First download strip (Figma M2.19-13 "Downloading… 62%") -->
        <LinearLayout
            android:id="@+id/ll_full_load_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ds_space_md"
            android:background="@drawable/bg_ds_card"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_md"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_load_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_fragment_percent_download_text"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_on_surface"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/pb_load_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:indeterminate="true"
                android:indeterminateTint="@color/ds_primary"
                android:progressBackgroundTint="@color/ds_outline_variant"
                android:progressTint="@color/ds_primary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
