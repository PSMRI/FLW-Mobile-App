<?xml version="1.0" encoding="utf-8"?>
<!--
    Disease-control form shell (malaria / kala-azar / AES / filaria / leprosy screening / confirmed follow-up) ·
    redesign (Figma 07 · Register member shell as fragment_new_form; M2.8 screening forms): surface #F5F7FA, 16dp padding;
    summary card in primary-container (r16, no border, text #001E31); fields inside a white section card (r16, 1dp
    #DCE1E8); 48dp filled pill Submit full width under the card; edit FAB in primary.
    Ids unchanged; old layout: legacy_fragment_maleria_form.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    xmlns:tools="http://schemas.android.com/tools">

    <org.piramalswasthya.sakhi.utils.SafeNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_md">


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_patient_information"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_md"
                app:layout_constraintTop_toTopOf="parent"
                app:cardBackgroundColor="@color/ds_primary_container"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_patient_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/ll_patient_information_1"
                        app:layout_constraintTop_toTopOf="@+id/cl_patient_information"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tv_ben_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="@dimen/ds_space_sm"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tv_age_gender"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_age_gender"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="@dimen/ds_space_sm"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </LinearLayout>
                    <RelativeLayout
                        android:id="@+id/ll_patient_information_3"
                        app:layout_constraintTop_toBottomOf="@+id/ll_patient_information_1"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/visitno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/visit_no"
                            android:padding="@dimen/ds_space_sm"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                            android:textColor="@color/ds_on_primary_container"
                            />

                        <TextView
                            android:id="@+id/number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_alignParentRight="true"
                            android:layout_marginEnd="50dp"
                            android:gravity="center"
                            android:padding="@dimen/ds_space_sm"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/ll_patient_information_2"
                        app:layout_constraintTop_toBottomOf="@+id/ll_patient_information_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:padding="@dimen/ds_space_sm"
                        >
                        <LinearLayout
                            android:id="@+id/ll_ben_pwr_tracking_details_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/husband_s_name"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/husband_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tv_mob_no_ph"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/mobile_number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_ben_pwr_tracking_details_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/beneficiary_id"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/ben_id"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tv_rch_id"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/rch_id"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_ben_pwr_tracking_details_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pregnancy_weeks"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/weeks_of_preg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pmsma_lmp"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/lmp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pmsma_edd"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/edd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Figma section card: white, r16, 1dp #DCE1E8; fields carry their own 16dp side padding -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <include
                    android:id="@+id/form"
                    layout="@layout/rv_input_form"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/ds_space_xs"
                    android:layout_weight="1" />


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:srcCompat="@drawable/ic_edit"
                    android:layout_marginEnd="@dimen/padding_wide"
                    android:layout_marginBottom="@dimen/padding_wide"
                    android:contentDescription="@string/edit"
                    app:backgroundTint="@color/ds_primary"
                    app:tint="@color/ds_on_primary" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginTop="@dimen/ds_space_md"
                android:text="@string/btn_submit" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/visitsRV"
                android:layout_width="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="vertical"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </org.piramalswasthya.sakhi.utils.SafeNestedScrollView>




    <ProgressBar
        android:id="@+id/pb_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />



</FrameLayout>