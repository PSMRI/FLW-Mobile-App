<?xml version="1.0" encoding="utf-8"?>
<!--
    Eligible couple card · redesign (Figma "FLW App Redesign" › M2.3-02 · EC registration list › card):
    white card, 1dp #DCE1E8, r16, padding 12/16, 8dp between rows.
    Header = 44dp initials avatar + name 16/24 + "W/o husband · age" 12/16 + sync badge (only once registered).
    Tags = "Missed period" (error tag, same rule as the old red icon). Values = 2-column grid (11/16 label, 14/20 value).
    Actions = IFA (outlined pill) + Register (filled) / View (tonal) — colours set in ECRegistrationAdapter.
    Every id, binding and click is kept. Old layout: legacy_rv_item_ben_ec_with_form.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="benWithEcr"
            type="org.piramalswasthya.sakhi.model.BenWithEcrDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.ECRegistrationAdapter.ClickListener" />

        <variable
            name="father"
            type="Boolean" />
        <variable
            name="husband"
            type="Boolean" />
        <variable
            name="spouse"
            type="Boolean"/>

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_ec_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:id="@+id/ll_title_ec_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{benWithEcr.ben.benName + ' ' + benWithEcr.ben.benSurname}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container"
                        tools:text="PK" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_ec_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{benWithEcr.ben.benName + ' ' + benWithEcr.ben.benSurname}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface"
                        tools:text="Priya Kumari" />

                    <!-- meta: "W/o husband · age" (text built in the adapter), wraps to 2 lines like Figma -->
                    <LinearLayout
                        android:id="@+id/ll_ben_ec_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant"
                            tools:text="W/o Rahul Reddy · 36 Years 5 Months" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/iv_sync_state"
                    style="@style/Sakhi.Badge"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:contentDescription="@string/iv_sync_state_tv"
                    dsSyncBadge="@{benWithEcr.ecr.syncState}"
                    tools:text="Synced" />
            </LinearLayout>

            <!-- ===== Tags ===== -->
            <TextView
                android:id="@+id/iv_miss_state"
                style="@style/Sakhi.Tag"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:backgroundTint="@color/ds_error_container"
                android:text="@string/missed_period"
                android:textColor="@color/ds_error"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ===== Values ===== -->
            <LinearLayout
                android:id="@+id/linear_ec_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_ben_ec_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            dsBenIdText="@{benWithEcr.ben.benId}"
                            tools:text="438560250526" />
                    </LinearLayout>

                    <LinearLayout style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_mob_no_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{benWithEcr.ben.mobileNo}"
                            tools:text="9868683485" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_ben_ec_details_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_rch_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(benWithEcr.ben.rchId == null || benWithEcr.ben.rchId.empty) ? @string/ds_empty_value : benWithEcr.ben.rchId}"
                            tools:text="123456789012" />
                    </LinearLayout>

                    <LinearLayout style="@style/Sakhi.InfoCell">

                        <TextView
                            android:id="@+id/tv_weeks_of_pregnancy_ph"
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/no_of_childrens" />

                        <TextView
                            android:id="@+id/noOfchild"
                            style="@style/Sakhi.InfoValue"
                            tools:text="0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- LMP · status (only once registered; the adapter hides them otherwise) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llLmpDate"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/lmp_date" />

                        <TextView
                            android:id="@+id/benLmpDate"
                            style="@style/Sakhi.InfoValue"
                            tools:text="22-08-2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llBenStatus"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/status" />

                        <TextView
                            android:id="@+id/benStatus"
                            style="@style/Sakhi.InfoValue"
                            tools:text="Missed Period" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Actions ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ifa"
                    style="@style/Widget.Sakhi.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{()-> clickListener.clickedAddAllBenBtn(benWithEcr,false,true)}"
                    android:text="@string/ifa"
                    app:gender="@{benWithEcr.ben.gender}"
                    app:isDeath="@{benWithEcr.ben.isDeathValue}"
                    app:reproductiveStatusId="@{benWithEcr.ben.reproductiveStatusId}"
                    app:visibleIfEligibleFemale="@{benWithEcr.ben.ageInt}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_form_ec1"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="104dp"
                    android:onClick="@{()-> clickListener.onClickForm(benWithEcr)}"
                    android:text="@string/register" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
