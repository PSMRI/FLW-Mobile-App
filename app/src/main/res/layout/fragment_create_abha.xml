<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.10-06 / -16 / -18 "ABHA created / already exists / here is your ABHA" — steps (all done; hidden in
     the find flow), result icon 56 + title 22/28, ABHA card (primary r24, padding 20, gap 12: id icon + "ABHA number",
     number 24/32, name 14/20), "Linked to beneficiary" success banner, download question card (r16) with No (outlined) /
     Yes (filled). Content padding 16, gap 16. Old layout: legacy_fragment_create_abha.xml. All view ids unchanged. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.abha_id_activity.create_abha_id.CreateAbhaFragment">

    <data>
        <variable
            name="viewModel"
            type="org.piramalswasthya.sakhi.ui.abha_id_activity.create_abha_id.CreateAbhaViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/cl_create_abha_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <include layout="@layout/layout_ds_abha_steps" />

                <!-- Figma "Result": icon 56 + title 22/28, gap 8 -->
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/check_circle"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
                    android:textColor="@color/ds_on_surface"
                    tools:text="ABHA account successfully created!" />

                <!-- Figma "ABHA card" -->
                <LinearLayout
                    android:id="@+id/cardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ds_abha_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ds_badge_card"
                            app:tint="@color/ds_on_primary" />

                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/ds_abha_number"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_primary_container" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/ds_on_primary"
                        android:textSize="24sp"
                        app:lineHeight="32sp"
                        tools:text="91-4521-7788-3012" />

                    <!-- Kept for its id ("Name :" label); the name below needs no label -->
                    <TextView
                        android:id="@+id/textView1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/name_"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                        android:textColor="@color/ds_primary_container"
                        tools:text="Sunita Devi" />
                </LinearLayout>

                <!-- Figma "Banner" Success: "Linked to beneficiary" + name -->
                <LinearLayout
                    android:id="@+id/ll_abha_ben_mapped"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ds_banner_success"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_check_circle"
                        app:tint="@color/ds_success" />

                    <TextView
                        android:id="@+id/abh_ben_mapped_txt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/linked_to_beneficiary"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                        android:textColor="@color/ds_on_surface" />
                </LinearLayout>

                <!-- Figma "Download question": white card r16, padding 16, gap 12; No outlined · Yes filled -->
                <LinearLayout
                    android:id="@+id/cl_download_abha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ds_card_r16"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/txt_download_abha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/do_you_want_to_download_the_abha_card"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                        android:textColor="@color/ds_on_surface" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_download_abha_no"
                            style="@style/Widget.Sakhi.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            android:text="@string/no" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_download_abha_yes"
                            style="@style/Widget.Sakhi.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="24dp"
                            android:text="@string/yes" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mobile OTP block (hidden in the app today), same kit as the OTP screens -->
                <LinearLayout
                    android:id="@+id/cl_verify_mobile_otp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_otp_msg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                        android:textColor="@color/ds_on_surface"
                        android:visibility="invisible" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputLayout"
                        style="@style/Widget.Sakhi.TextField.Boxed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tiet_aadhaar_otp"
                            style="@style/Widget.Sakhi.TextField.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/enter_otp"
                            android:inputType="number"
                            android:maxLength="6"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tv_error_text_verify"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/textview"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_error"
                            android:visibility="gone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resend_otp"
                            style="@style/Widget.Sakhi.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/resend_otp" />

                        <TextView
                            android:id="@+id/timer_resend_otp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/_30"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                            android:textColor="@color/ds_on_surface_variant" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_verify_OTP"
                        style="@style/Widget.Sakhi.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:text="@string/verify_otp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/textview"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_error"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pb_cai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ds_primary" />

        <!-- Offline: Figma "Empty state" (M2.10-07) -->
        <LinearLayout
            android:id="@+id/cl_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            android:paddingTop="48dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_ds_empty_illustration">

                <ImageView
                    android:id="@+id/iv_offline"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/offline"
                    android:src="@drawable/ic_ds_wifi_off"
                    app:tint="@color/ds_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/something_went_wrong_nunable_to_connect_to_server_ntry_again_later"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                android:textColor="@color/ds_on_surface_variant" />
        </LinearLayout>
    </FrameLayout>
</layout>
