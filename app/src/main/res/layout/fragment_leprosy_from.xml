<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmed-case / visit form shell (leprosy confirmed, leprosy visit, TB confirmed) · redesign (Figma 07 · Register
    member shell as fragment_new_form; M2.7 / M2.8 follow-up forms): surface #F5F7FA, 16dp padding; summary card in
    primary-container (r16, text #001E31); fields inside a white section card (r16, 1dp #DCE1E8); 48dp filled pill Submit
    full width; "Follow-up history" section title 16/24 Medium over the follow-up date rows.
    Ids unchanged; old layout: legacy_fragment_leprosy_from.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_md">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_patient_information"
            style="@style/Widget.Sakhi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_md"
            app:layout_constraintTop_toTopOf="parent"
            app:cardBackgroundColor="@color/ds_primary_container"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_patient_information"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/ll_patient_information_1"
                    app:layout_constraintTop_toTopOf="@+id/cl_patient_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_ben_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="@dimen/ds_space_sm"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_primary_container"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_age_gender"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_age_gender"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="@dimen/ds_space_sm"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container"
                        app:layout_constraintEnd_toEndOf="parent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_patient_information_2"
                    app:layout_constraintTop_toBottomOf="@+id/ll_patient_information_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="@dimen/ds_space_sm"
                    >
                    <LinearLayout
                        android:id="@+id/ll_ben_pwr_tracking_details_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/husband_s_name"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/husband_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_mob_no_ph"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/mobile_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_ben_pwr_tracking_details_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/beneficiary_id"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/ben_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_rch_id"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/rch_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_ben_pwr_tracking_details_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pregnancy_weeks"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/weeks_of_preg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pmsma_lmp"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/lmp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pmsma_edd"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/edd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Figma section card: white, r16, 1dp #DCE1E8; fields carry their own 16dp side padding -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sakhi.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/form"
                layout="@layout/rv_input_form"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginVertical="@dimen/ds_space_xs"
                android:layout_weight="1" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginTop="@dimen/ds_space_md"
            android:text="@string/btn_submit" />

        <TextView
            style="@style/Sakhi.G25.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:text="@string/follow_up_history"
            android:layout_marginBottom="@dimen/ds_space_2xs" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_follow_up_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            tools:listitem="@layout/item_follow_up_date" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/pb_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />



</FrameLayout>