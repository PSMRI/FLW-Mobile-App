<?xml version="1.0" encoding="utf-8"?>
<!--
    Age picker dialog · redesign (Figma M2.19-50 · Age picker › "Dialog · Enter age"): white r24 card, padding 24,
    gap 16; title "Enter age" 22/28 Medium; three columns (gap 16) with label 14/20 Medium #42474E above each
    picker; actions right-aligned: "Cancel" text pill + "OK" filled pill (48dp, gap 8).
    The three NumberPickers are kept (typing + Latin-digit logic in AgePickerDialog); ids unchanged.
    Not built: Figma's 56dp −/value/+ stepper boxes and the "Limits follow the relation…" helper (needs the limits text).
    Old layout: legacy_alert_age_picker.xml.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ds_space_xl"
    app:cardBackgroundColor="@color/ds_surface_container"
    app:cardCornerRadius="@dimen/ds_radius_xl"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ds_g27_enter_age"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
            android:textColor="@color/ds_on_surface" />

        <LinearLayout
            android:id="@+id/date_number_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:gravity="center"
                    android:text="@string/years" />

                <NumberPicker
                    android:id="@+id/dialog_number_picker_years"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:gravity="center"
                    android:text="@string/months" />

                <NumberPicker
                    android:id="@+id/dialog_number_picker_months"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:gravity="center"
                    android:text="@string/days" />

                <NumberPicker
                    android:id="@+id/dialog_number_picker_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Figma "Actions": right-aligned, gap 8 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.Sakhi.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/ds_space_xl"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ok"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_xs"
                android:enabled="true"
                android:paddingHorizontal="@dimen/ds_space_xl"
                android:text="@string/ok" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
