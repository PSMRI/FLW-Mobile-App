<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: dropdown menu row — 48dp, padding 16, Body/Large on-surface. Old layout: legacy_dropdown_item_abha.xml. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_dropdown_item_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="2"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
    android:textColor="@color/ds_on_surface" />
