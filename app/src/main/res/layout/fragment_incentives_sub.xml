<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.11-04 "Rejected activity → records" — surface bg, section header "Activity: …" 16/24 with the
     amount label 12/16, record cards below. Old layout: legacy_fragment_incentives_sub.xml. Ids and bindings unchanged. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="activity_name"
            type="String" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface"
        tools:context=".ui.home_activity.incentives.IncentivesSubFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Figma "Section header" -->
            <LinearLayout
                android:id="@+id/header_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- Kept for its id; the avatar on each card shows the number -->
                <TextView
                    android:id="@+id/tvHeaderSerialNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S.No"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHeaderActivity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{@string/activity_name(activity_name)}"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    tools:text="Activity: Full immunization of child" />

                <TextView
                    android:id="@+id/tvAmountActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Amount claimed (Rs.)"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                    android:textColor="@color/ds_on_surface_variant" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sub_incentive"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/rv_item_incentive" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_Bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ds_primary" />
    </FrameLayout>
</layout>
