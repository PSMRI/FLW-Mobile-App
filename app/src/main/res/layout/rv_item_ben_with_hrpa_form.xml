<?xml version="1.0" encoding="utf-8"?>
<!--
    HRP (pregnant) assessment card · redesign (Figma M2.6 high-risk lists, same card pattern): initials + name +
    "W/o husband · age" (adapter) + sync badge; ben ID / mobile / RCH ID, then weeks / LMP / EDD (only with an LMP);
    up to three form buttons whose colour shows the form state (set in HRPAdapter: not started = filled primary,
    partly filled = warning tonal, complete = success tonal, share = outlined). Every id, binding and click is kept.
    Old layout: legacy_rv_item_ben_with_hrpa_form.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />

        <variable
            name="benWithhrpa"
            type="org.piramalswasthya.sakhi.model.BenWithHRPADomain" />
        <variable
            name="hasLmp"
            type="Boolean" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.HRPAdapter.HRPAClickListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_hrpa_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <LinearLayout
                android:id="@+id/ll_title_hrpa_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{benWithhrpa.ben.benFullName}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_hrpa_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{benWithhrpa.ben.benFullName}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface" />

                    <LinearLayout
                        android:id="@+id/ll_ben_hrpa_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/iv_sync_state"
                    style="@style/Sakhi.Badge"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:contentDescription="@string/iv_sync_state_tv"
                    dsSyncBadge="@{benWithhrpa.assess.syncState}"
                    tools:text="Synced" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_hrpa_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_ben_hrpa_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            dsBenIdText="@{benWithhrpa.ben.benId}" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_mob_no_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{benWithhrpa.ben.mobileNo}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_rch_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(benWithhrpa.ben.rchId == null || benWithhrpa.ben.rchId.empty) ? @string/ds_empty_value : benWithhrpa.ben.rchId}" />
                    </LinearLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_ben_hrpa_tracking_details_3"
                    showLayout="@{hasLmp}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/pregnancy_weeks" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{benWithhrpa.weeksOfPregnancy}" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/pmsma_lmp" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{benWithhrpa.lmpString}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    showLayout="@{hasLmp}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/pmsma_edd" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{benWithhrpa.eddString}" />
                    </LinearLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_btn_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_form2"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:onClick="@{()-> clickListener.onClickForm2(benWithhrpa)}"
                    android:text="@string/register"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_form1"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:onClick="@{()-> clickListener.onClickForm1(benWithhrpa)}"
                    android:text="@string/register"
                    android:visibility="gone" />
                <!-- Share = icon-only outlined WhatsApp button (48dp) so both form labels fit in full -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_form3"
                    style="@style/Widget.Sakhi.Button.Outlined"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/share"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="48dp"
                    android:onClick="@{()-> clickListener.onClickForm3(benWithhrpa)}"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:visibility="gone"
                    app:icon="@drawable/icon_whatsapp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    app:iconTint="@null" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
