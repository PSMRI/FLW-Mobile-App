<?xml version="1.0" encoding="utf-8"?>
<!--
    Follow-up table row (children under 5 form · follow-up visits) · redesign (row 26), Figma table "Row": white, padding 8/12,
    values 14/20 (S.No in Medium), 1dp #DCE1E8 hairline below. Bindings unchanged. Old layout: legacy_item_follow_up_visit.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="sno"
            type="String" />
        <variable
            name="visitDate"
            type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:background="@color/ds_surface_container"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ds_space_sm"
            android:paddingVertical="@dimen/ds_space_xs">

            <!-- Serial Number -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{sno}"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_on_surface"
                tools:text="1" />

            <!-- Follow Up Date -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@{visitDate}"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                android:textColor="@color/ds_on_surface"
                tools:text="29-09-2025" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ds_outline_variant" />
    </LinearLayout>
</layout>
