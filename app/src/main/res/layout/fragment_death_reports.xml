<?xml version="1.0" encoding="utf-8"?>
<!--
    Death reports hub · redesign: the same module tiles as every other hub (rv_item_icon_grid: white card, 48dp tone icon
    square, chevron, title 14/20, count in the module colour) in a 2×2 grid on the surface background, instead of the
    orange-icon cards with floating count bubbles. Ids, clicks and count bindings unchanged.
    Old layout: legacy_fragment_death_reports.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="generalIcon"
            type="org.piramalswasthya.sakhi.model.Icon" />

        <variable
            name="maternalIcon"
            type="org.piramalswasthya.sakhi.model.Icon" />

        <variable
            name="nonMaternalIcon"
            type="org.piramalswasthya.sakhi.model.Icon" />

        <variable
            name="childIcon"
            type="org.piramalswasthya.sakhi.model.Icon" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.IconGridAdapter.GridIconClickListener" />

        <variable
            name="scope"
            type="kotlinx.coroutines.CoroutineScope" />

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_xs"
        android:paddingTop="@dimen/ds_space_xs"
        android:paddingBottom="@dimen/ds_space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_general_deaths"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> clickListener.onClicked(generalIcon)}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="142dp"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            dsModuleIcon="@{generalIcon.icon}"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ds_module_icon"
                            android:contentDescription="@{generalIcon.title}"
                            android:padding="11dp"
                            android:scaleType="fitCenter" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_general_deaths_label"
                        dsTileTitle="@{generalIcon.title}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface"
                        tools:text="General Deaths" />

                    <TextView
                        android:id="@+id/tv_general_deaths_count"
                        dsModuleToneText="@{generalIcon.icon}"
                        recordCount="@{generalIcon.count}"
                        scope="@{scope}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        tools:text="0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_maternal_deaths"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> clickListener.onClicked(maternalIcon)}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="142dp"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            dsModuleIcon="@{maternalIcon.icon}"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ds_module_icon"
                            android:contentDescription="@{maternalIcon.title}"
                            android:padding="11dp"
                            android:scaleType="fitCenter" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_maternal_deaths_label"
                        dsTileTitle="@{maternalIcon.title}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface"
                        tools:text="General Deaths" />

                    <TextView
                        android:id="@+id/tv_maternal_deaths_count"
                        dsModuleToneText="@{maternalIcon.icon}"
                        recordCount="@{maternalIcon.count}"
                        scope="@{scope}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        tools:text="0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_non_maternal_deaths"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> clickListener.onClicked(nonMaternalIcon)}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="142dp"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            dsModuleIcon="@{nonMaternalIcon.icon}"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ds_module_icon"
                            android:contentDescription="@{nonMaternalIcon.title}"
                            android:padding="11dp"
                            android:scaleType="fitCenter" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_non_maternal_deaths_label"
                        dsTileTitle="@{nonMaternalIcon.title}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface"
                        tools:text="General Deaths" />

                    <TextView
                        android:id="@+id/tv_non_maternal_deaths_count"
                        dsModuleToneText="@{nonMaternalIcon.icon}"
                        recordCount="@{nonMaternalIcon.count}"
                        scope="@{scope}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        tools:text="0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_child_deaths"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> clickListener.onClicked(childIcon)}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="142dp"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            dsModuleIcon="@{childIcon.icon}"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ds_module_icon"
                            android:contentDescription="@{childIcon.title}"
                            android:padding="11dp"
                            android:scaleType="fitCenter" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_child_deaths_label"
                        dsTileTitle="@{childIcon.title}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface"
                        tools:text="General Deaths" />

                    <TextView
                        android:id="@+id/tv_child_deaths_count"
                        dsModuleToneText="@{childIcon.icon}"
                        recordCount="@{childIcon.count}"
                        scope="@{scope}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        tools:text="0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</layout>
