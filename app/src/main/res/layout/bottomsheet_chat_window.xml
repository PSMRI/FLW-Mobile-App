<?xml version="1.0" encoding="utf-8"?>
<!--
    Chat window sheet · redesign (Figma bottom-sheet pattern from M2.19-04 / M2.19-18 / M2.19-20: white, top r24,
    12dp top padding, 32×4 #72787E handle, 12dp gap). Loading spinner centred in primary instead of the fixed
    150/200dp offsets. WebView / ProgressBar ids and types unchanged. No dedicated Figma frame for the chat itself.
    Old layout: legacy_bottomsheet_chat_window.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_bottom_sheet_r24"
    android:orientation="vertical"
    android:paddingTop="@dimen/ds_space_sm"
    tools:context="org.piramalswasthya.sakhi.ui.home_activity.HomeActivity">

    <View style="@style/Widget.Sakhi.G27.SheetHandle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_marginTop="@dimen/ds_space_sm">

        <ProgressBar
            android:id="@+id/progressBarv"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ds_primary"
            android:max="3"
            android:progress="100" />

        <WebView
            android:id="@+id/webv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="true"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
