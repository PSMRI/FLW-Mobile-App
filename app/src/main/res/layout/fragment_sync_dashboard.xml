<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:orientation="vertical">
    <!-- Redesign (08 · Sync): surface background, tabs in primary / on-surface-variant. Old: legacy_fragment_sync_dashboard.xml -->

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/ds_primary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/ds_primary"
        app:tabTextAppearance="@style/TextAppearance.Sakhi.TitleSmall"
        app:tabTextColor="@color/ds_on_surface_variant" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
