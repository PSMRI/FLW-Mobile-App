<?xml version="1.0" encoding="utf-8"?>
<!--
  Shelf row: artwork, badge name, and one line on what earns it. No numbers here —
  progress belongs on the dashboard card, which is where she looks for "how far am I".
  This screen answers a different question: which badges exist, and what are they for.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/padding_small"
    app:cardCornerRadius="@dimen/padding_normal"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/padding_normal">

        <ImageView
            android:id="@+id/iv_badge_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/badge_shelf_title"
            android:scaleType="centerInside"
            tools:src="@drawable/badge_steady_syncer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_normal"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_badge_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Steady Syncer" />

            <TextView
                android:id="@+id/tv_badge_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                tools:text="Sync your app at least once every week" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
