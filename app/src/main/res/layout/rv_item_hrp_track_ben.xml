<?xml version="1.0" encoding="utf-8"?>
<!--
    HRP follow-up history row (bottom sheet) · redesign: visit date (title) + sync badge + View (tonal), on a hairline-
    separated row. Ids, bindings and click unchanged. Old layout: legacy_rv_item_hrp_track_ben.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="track"
            type="org.piramalswasthya.sakhi.model.HRPPregnantTrackDomain" />

        <variable
            name="visit"
            type="String" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.HRPPregTrackAdapter.HRPTrackClickListener" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingVertical="@dimen/ds_space_xs">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{track.filledOnString}"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface"
                tools:text="12-10-2026" />

            <TextView
                android:id="@+id/iv_sync_state"
                style="@style/Sakhi.Badge"
                android:layout_marginHorizontal="@dimen/ds_space_xs"
                android:contentDescription="@string/iv_sync_state_tv"
                dsSyncBadge="@{track.syncState}"
                tools:text="Synced" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Sakhi.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{() -> clickListener.onClickedBen(track)}"
                android:text="@string/ds_view" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/ds_space_md"
            android:background="@color/ds_outline_variant" />
    </LinearLayout>
</layout>
