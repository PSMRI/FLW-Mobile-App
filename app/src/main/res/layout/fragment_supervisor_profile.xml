<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.12-06 "Supervisor profile" — surface bg; header name 22/28, role 14/20, ID 14/20 Medium; section
     headers 16/24; info rows as white cards r16 with 1dp outline-variant, primary 24dp icons, label 12/16 variant +
     value 16/24. Structure kept (token pass). Old layout: legacy_fragment_supervisor_profile.xml. Ids unchanged. -->
<androidx.core.widget.NestedScrollView android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ds_surface"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profileDetailLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="10dp"
            >
            <ImageView
                android:id="@+id/iv_nhm_logo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="@string/cd_assam_nhm_logo"
                android:src="@drawable/logo_circle"
                />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/supervisor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/padding_small"
                app:layout_constraintStart_toEndOf="@+id/iv_nhm_logo"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:text="@string/name"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
                android:textColor="@color/ds_on_surface"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/subName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/padding_small"
                app:layout_constraintTop_toBottomOf="@+id/supervisor_name"
                app:layout_constraintStart_toEndOf="@+id/iv_nhm_logo"
                android:layout_marginStart="10dp"
                android:text="@string/str_supervisor"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                android:textColor="@color/ds_on_surface_variant"
                android:gravity="center"
                />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/supervisorId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/padding_small"
                app:layout_constraintTop_toBottomOf="@+id/subName"
                app:layout_constraintStart_toEndOf="@+id/iv_nhm_logo"
                android:layout_marginStart="10dp"
                android:text="@string/id_details"
                android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                android:textColor="@color/ds_on_surface_variant"
                android:gravity="center"
                />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:cardBackgroundColor="@color/ds_primary_container"
                app:layout_constraintTop_toTopOf="@+id/supervisorId">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"/>
            </com.google.android.material.card.MaterialCardView>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/contactInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:text="@string/contact_info"
            app:layout_constraintStart_toStartOf="parent"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/profileDetailLayout" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mobileCard"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/contactInfo"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:strokeColor="@color/ds_outline_variant"
            app:strokeWidth="1dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            android:layout_marginEnd="16dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/ic_call_icon"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/icon"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:text="@string/mobile_number"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>


            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/emailCard"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@+id/mobileCard"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:strokeColor="@color/ds_outline_variant"
            app:strokeWidth="1dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            android:layout_marginEnd="16dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/emailIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/baseline_email_24"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/emailIcon"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/emailtvTitle"
                        android:text="@string/email"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/emailtvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>


            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/districCard"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@+id/emailCard"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:strokeColor="@color/ds_outline_variant"
            app:strokeWidth="1dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            android:layout_marginEnd="16dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/districIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/baseline_location_on_24"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/districIcon"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/districtvTitle"
                        android:text="@string/district"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/districtvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>


            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/blockCard"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@+id/districCard"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:strokeColor="@color/ds_outline_variant"
            app:strokeWidth="1dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            android:layout_marginEnd="16dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/blockIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/ic_home"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/blockIcon"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/blocktvTitle"
                        android:text="@string/block"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/blocktvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>


            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/subcenterCard"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@+id/blockCard"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:strokeColor="@color/ds_outline_variant"
            app:strokeWidth="1dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            android:layout_marginEnd="16dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/subcenterIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/ic_home"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/subcenterIcon"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/subcentertvTitle"
                        android:text="@string/str_subcenter"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/subcentertvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>


            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/bankDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/padding_small"
            android:visibility="gone"
            android:paddingBottom="@dimen/padding_small"
            app:tint="@color/ds_primary"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:text="@string/bank_details"
            app:layout_constraintStart_toStartOf="parent"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/subcenterCard" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/accountCard"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/bankDetails"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:strokeColor="@color/ds_outline_variant"
            app:strokeWidth="1dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            android:layout_marginEnd="16dp"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/bankIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/ic_bank_name"
                    />

                <LinearLayout
                    android:id="@+id/ttLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/bankIcon"
                    android:layout_marginStart="16dp"
                    >

                    <TextView
                        android:id="@+id/banktvTitle"
                        android:text="@string/bank_acc"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/banktvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/outline_keyboard_arrow_right_24"
                    android:layout_alignParentEnd="true"
                    />

                <View
                    android:id="@+id/underLine"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/ttLayout"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/ds_outline_variant"/>

                <ImageView
                    android:id="@+id/ifscIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_below="@+id/underLine"
                    android:layout_marginTop="10dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/ic_bank_name"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:id="@+id/bottomLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/ifscIcon"
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/underLine"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/ifscTitle"
                        android:text="@string/ifsc_code"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/ifsctvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignRight="@+id/bottomLayout"
                    android:layout_below="@+id/underLine"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/outline_keyboard_arrow_right_24"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small"
            app:tint="@color/ds_primary"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:text="@string/app_settings"
            app:layout_constraintStart_toStartOf="parent"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/accountCard" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/appSettingCard"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/settingText"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:strokeColor="@color/ds_outline_variant"
            app:strokeWidth="1dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            android:layout_marginEnd="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingRight="12dp"
                android:paddingLeft="12dp">
                <ImageView
                    android:id="@+id/logoutIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="10dp"
                    app:tint="@color/ds_primary"
                    android:src="@drawable/ic_logout"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:id="@+id/logoutlayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/logoutIcon"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/logoutTitle"
                        android:text="@string/logout"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                        android:textColor="@color/ds_on_surface_variant"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/logoutTvValue"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                        android:textColor="@color/ds_on_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignRight="@+id/logoutlayout"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/outline_keyboard_arrow_right_24"
                    android:layout_alignParentEnd="true"
                    />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@+id/appSettingCard"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
