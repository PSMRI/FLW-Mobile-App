<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    tools:context=".ui.home_activity.maternal_health.pregnant_woment_anc_visits.homeVisit.AntenatalCounsellingFragment">
    <!-- Antenatal counselling (ANC home visit) · redesign (row 26), shell of fragment_new_form (Figma M2.2-06 "ANC home visit &
         counselling"): surface bg, summary card in primary-container (r16; labels 11/16, values 14/20), the questionnaire in a white
         section card, Submit = 48dp pill in a white bottom action bar (collapses when hidden), edit FAB in primary.
         Ids unchanged. Old layout: legacy_fragment_antenatal_counselling.xml. -->

    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_patient_information"
            style="@style/Widget.Sakhi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ds_space_md"
            android:layout_marginTop="@dimen/ds_space_md"
            app:cardBackgroundColor="@color/ds_primary_container"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPregnantWomanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/name_of_pregnant_woman"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvPregnantWomanValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHusbandLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/husband_name"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvHusbandValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAgeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/age"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvAgeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRegDateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/reg_date"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvRegDateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLmpLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/pmsma_lmp"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvLmpValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWeeksLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/pregnancy_weeks"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvWeeksValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEddLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/string_edd"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvEddValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPhoneLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/phone_no"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvPhoneValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLastVisitLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/last_home_visit_date"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                            android:textColor="@color/ds_on_primary_container" />

                        <TextView
                            android:id="@+id/tvLastVisitValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <!-- Figma section card: white, r16, 1dp #DCE1E8 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ds_space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/ds_space_xs">

                    <FrameLayout
                        android:id="@+id/mother_questionnaire_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/cbSelectAll"
                        style="@style/Widget.Sakhi.CheckboxOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_md"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:layout_marginEnd="@dimen/ds_space_md"
                        android:text="@string/select_all"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.core.widget.NestedScrollView>

        <!-- Figma "Bottom action bar": white, padding 12/16, 48dp pill (padding on the button so the bar collapses when it is hidden) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_bottom_bar"
            android:paddingHorizontal="@dimen/ds_space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/ds_space_sm"
                android:text="@string/submit" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/ds_space_md"
        android:layout_marginBottom="88dp"
        android:contentDescription="@string/edit"
        android:visibility="gone"
        app:backgroundTint="@color/ds_primary"
        app:srcCompat="@drawable/ic_edit"
        app:tint="@color/ds_on_primary"
        tools:visibility="visible" />

</FrameLayout>