<?xml version="1.0" encoding="utf-8"?>
<!--
    Child immunization list card · redesign (Figma M2.5 immunization lists, same card pattern): initials + name +
    "Mother: name · age" (adapter) ; "Deceased" tag; gender / DOB / father / mother / ben ID / mobile / child + mother
    RCH ID; Show vaccines (filled). Every id, binding and click is kept.
    Old layout: legacy_rv_item_ben_child_immunization.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="temp"
            type="org.piramalswasthya.sakhi.model.BenBasicDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.BenChildImmunizationListAdapter.VaccinesClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <LinearLayout
                android:id="@+id/ll_title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{temp.benFullName}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{temp.benFullName}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface" />

                    <LinearLayout
                        android:id="@+id/ll_ben_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- kept for their ids: the old title wrapper and sync icon (this list never showed sync) -->
                <LinearLayout
                    android:id="@+id/ll_title_bar_ll"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_sync_state"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/iv_isDeath"
                style="@style/Sakhi.Tag"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:backgroundTint="@color/ds_surface_container_high"
                android:contentDescription="@string/iv_death_indicator"
                android:text="@string/ds_deceased"
                android:textColor="@color/ds_on_surface"
                android:visibility="@{temp.isDeath == true ? View.VISIBLE : View.GONE}" />

            <LinearLayout
                android:id="@+id/ll_ben_imm_values"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/gender" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            app:localizedGender="@{temp.gender}" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/registration_date"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/date_of_birth" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:id="@+id/tvDob" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_ben_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ncd_father_name"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_father_name_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{temp.fatherName}" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/ncd_spouse_name"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/mother_name" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{temp.motherName}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_ben_details_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            dsBenIdText="@{temp.benId}" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/mobile_number" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{temp.mobileNo}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/child_rch_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(temp.rchId == null || temp.rchId.empty) ? @string/ds_empty_value : temp.rchId}" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/mother_rch_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(temp.rchId == null || temp.rchId.empty) ? @string/ds_empty_value : temp.rchId}" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button2"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:onClick="@{() -> clickListener.onClickedBen(temp)}"
                    android:text="@string/show_vaccines"
                    app:icon="@drawable/ic_vaccines"
                    app:iconTint="@color/ds_filled_fg" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
