<?xml version="1.0" encoding="utf-8"?>
<!--
    Uploaded file row · redesign (form kit "upload row"): bordered row (white, 1dp #DCE1E8, r12), 8dp apart,
    40dp file icon, name 14/20 Medium #191C1F (middle-ellipsized), delete icon 24dp error colour in a 48dp target.
    Ids unchanged; old layout: legacy_item_file.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_xs"
    android:background="@drawable/bg_ds_field_row"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="56dp"
    android:paddingStart="@dimen/ds_space_sm"
    android:paddingEnd="@dimen/ds_space_2xs">

    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_doc_upload"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_sm"
        android:layout_marginEnd="@dimen/ds_space_xs"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
        android:textColor="@color/ds_on_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_delete"
        app:layout_constraintStart_toEndOf="@id/iv_file_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="document_file_name.pdf" />

    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ds_g25_delete_file"
        android:src="@drawable/ic_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ds_error" />

</androidx.constraintlayout.widget.ConstraintLayout>
