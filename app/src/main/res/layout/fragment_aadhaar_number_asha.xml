<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.10-02 / -08 / -20 "Aadhaar number" — "Enter details for <name>", labelled 56dp boxes
     (Aadhaar with eye toggle, mobile, beneficiary name), checkbox-option consent row + "Tap to read the
     consent" link, filled 48dp "Generate OTP". Content padding 16, gap 12.
     Old layout: legacy_fragment_aadhaar_number_asha.xml. All view ids unchanged. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <!-- "Enter details for Sunita Devi" (14/20 Medium) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ben_name_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/generating_abha_for"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_on_surface"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ben_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_on_surface"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Aadhaar number: label + valid tick, box with masked blocks + eye -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView3"
                style="@style/Widget.Sakhi.FieldLabel"
                android:layout_width="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="@string/enter_number_for_abha" />

            <ImageView
                android:id="@+id/ivValidAadhaar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle_grey" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fl_aadhaar_box"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_ds_field_box">

            <org.piramalswasthya.sakhi.helpers.addharEditText.BlockEditText
                android:id="@+id/tiet_aadhaar_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="48dp"
                app:defaultLength="4"
                app:editTextBackground="@android:color/transparent"
                app:hintTextAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                app:inputType="Integer"
                app:numberOfBlock="3"
                app:separatorCharacter="-"
                app:separatorPadding="2dp"
                app:textSize="16sp" />

            <ImageView
                android:id="@+id/ivShowText"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/ds_abha_show_aadhaar" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/textview"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_error"
            android:visibility="gone" />

        <!-- Mobile number -->
        <TextView
            android:id="@+id/textView4"
            style="@style/Widget.Sakhi.FieldLabel"
            android:layout_marginTop="12dp"
            android:text="@string/enter_mobile_number" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_mobile_number"
                style="@style/Widget.Sakhi.TextField.Boxed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tiet_mobile_number"
                    style="@style/Widget.Sakhi.TextField.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/mobile_number"
                    android:inputType="number"
                    android:maxLength="10"
                    android:paddingEnd="48dp"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:id="@+id/ivValidMobile"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle_grey" />
        </FrameLayout>

        <!-- Beneficiary name (only when ABHA is opened without a beneficiary, M2.10-20) -->
        <LinearLayout
            android:id="@+id/clBenName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView6"
                style="@style/Widget.Sakhi.FieldLabel"
                android:text="@string/enter_ben_name" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_ben_name"
                    style="@style/Widget.Sakhi.TextField.Boxed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tiet_ben_name"
                        style="@style/Widget.Sakhi.TextField.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/tv_ben_name_ph"
                        android:inputType="textCapWords"
                        android:paddingEnd="48dp"
                        android:singleLine="true"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tv_error_text_ben_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/textview"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_error"
                        android:visibility="gone" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/ivValidBenName"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle_grey" />
            </FrameLayout>
        </LinearLayout>

        <!-- Figma "Consent": checkbox option row (ticked only after "I Agree" on the consent screen) + link.
             The whole block is covered by clickview, which opens the consent screen. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/aadharDisclaimer"
                    style="@style/Widget.Sakhi.CheckboxOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:enabled="false"
                    android:focusableInTouchMode="false"
                    android:paddingVertical="12dp"
                    android:text="@string/aadhar_disclaimer_consent_disclaimer" />

                <!-- Kept for its id; the text now sits on the checkbox row -->
                <TextView
                    android:id="@+id/aadharDisclaimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ds_abha_consent_tap"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                    android:textColor="@color/ds_primary" />
            </LinearLayout>

            <View
                android:id="@+id/clickview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verify_aadhaar"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/generate_otp" />

        <TextView
            android:id="@+id/pid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pid"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
