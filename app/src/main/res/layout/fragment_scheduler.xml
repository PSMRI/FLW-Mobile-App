                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ds_space_xs"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ds_stat"
                            android:backgroundTint="@color/ds_module_immunization_bg"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_space_sm">

                            <TextView
                                android:id="@+id/tvAbhaNewCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/_0"
                                android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                                android:textColor="@color/ds_module_immunization_fg"
                                tools:text="214" />

