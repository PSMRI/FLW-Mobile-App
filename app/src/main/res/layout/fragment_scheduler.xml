                    <TextView
                        android:id="@+id/tv_confirmed_hrp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/_0"
                        android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                        android:textColor="@color/ds_module_disease_fg"
                        tools:text="12" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/ds_space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- suspected_high_risk_non_pregnant_women -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_non_hrp"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
