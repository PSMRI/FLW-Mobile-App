            <!-- ABHA created: new / old counts -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_abha"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/clAbhaCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_group_on"
                            app:tint="@color/ds_primary" />

                        <TextView
                            android:id="@+id/tvphAbha"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/ds_space_sm"
                            android:layout_weight="1"
                            android:text="@string/icon_title_abha"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                            android:textColor="@color/ds_on_surface" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
