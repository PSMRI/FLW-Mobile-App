                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_icon_circle"
                        android:backgroundTint="@color/ds_module_disease_bg"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_icon_female"
                        app:tint="@color/ds_module_disease_fg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ds_space_sm"
                        android:layout_weight="1"
                        android:text="@string/suspected_high_risk_non_pregnant_women"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tv_hr_ec_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/_0"
                        android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                        android:textColor="@color/ds_module_disease_fg"
                        tools:text="12" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/ds_space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- high_risk_babies -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_hrb"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_icon_circle"
                        android:backgroundTint="@color/ds_module_child_bg"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_icon_baby"
                        app:tint="@color/ds_module_child_fg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ds_space_sm"
                        android:layout_weight="1"
                        android:text="@string/high_risk_babies"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tv_hrb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/_0"
                        android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                        android:textColor="@color/ds_module_child_fg"
                        tools:text="12" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/ds_space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- low_birth_weight_babies -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_lwb"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_icon_circle"
                        android:backgroundTint="@color/ds_module_child_bg"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_icon_baby"
                        app:tint="@color/ds_module_child_fg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ds_space_sm"
                        android:layout_weight="1"
                        android:text="@string/low_birth_weight_babies"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tv_lbwb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/_0"
                        android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                        android:textColor="@color/ds_module_child_fg"
                        tools:text="12" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/ds_space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- icon_title_missed_period -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_miss"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_icon_circle"
                        android:backgroundTint="@color/ds_module_maternal_bg"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/ds_module_maternal_fg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ds_space_sm"
                        android:layout_weight="1"
                        android:text="@string/icon_title_missed_period"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tv_miss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/_0"
                        android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                        android:textColor="@color/ds_module_maternal_fg"
                        tools:text="12" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/ds_space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- icon_title_no_follow_up -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_non"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_icon_circle"
                        android:backgroundTint="@color/ds_module_records_bg"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
