                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_icon_circle"
                        android:backgroundTint="@color/ds_module_immunization_bg"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_icon_baby"
                        app:tint="@color/ds_module_immunization_fg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ds_space_sm"
                        android:layout_weight="1"
