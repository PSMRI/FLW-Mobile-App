                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- icon_title_rch -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_rch"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_md"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_icon_circle"
                        android:backgroundTint="@color/ds_module_records_bg"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_rch_id_no"
                        app:tint="@color/ds_module_records_fg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ds_space_sm"
                        android:layout_weight="1"
                        android:text="@string/icon_title_rch"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tv_rch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/_0"
                        android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                        android:textColor="@color/ds_module_records_fg"
                        tools:text="12" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/ds_space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- My impact: badge progress carousel (tap opens badge shelf; hidden when badges are off) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_impact_dashboard"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/ds_space_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/ds_space_md"
                        android:paddingEnd="@dimen/ds_space_xs">

                        <TextView
                            android:id="@+id/tv_impact_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/impact_dashboard_title"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                            android:textColor="@color/ds_on_surface" />

                        <ImageButton
                            android:id="@+id/btn_carousel_prev"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/impact_carousel_prev"
                            android:rotation="180"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ds_on_surface_variant" />

                        <TextView
                            android:id="@+id/tv_carousel_counter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minWidth="40dp"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_on_surface_variant"
                            tools:text="3 / 8" />

                        <ImageButton
                            android:id="@+id/btn_carousel_next"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/impact_carousel_next"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ds_primary" />
                    </LinearLayout>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vp_impact_badges"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginTop="@dimen/ds_space_2xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pb_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/ds_primary" />

</FrameLayout>
