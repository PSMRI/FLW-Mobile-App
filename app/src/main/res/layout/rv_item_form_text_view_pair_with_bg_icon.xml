<?xml version="1.0" encoding="utf-8"?>
<!--
    Two read-only values side by side · redesign (Figma field style): each column = label above + grey read-only box,
    12dp apart. Used by FormInputAdapterWithBgIcon. Ids unchanged; old layout: legacy_rv_item_form_text_view_pair_with_bg_icon.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="form"
            type="org.piramalswasthya.sakhi.model.FormElement" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingVertical="@dimen/ds_space_xs">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_label"
                style="@style/Widget.Sakhi.FieldLabel"
                asteriskRequired="@{form.required}"
                hintText="@{form.title}" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_text"
                style="@style/Widget.Sakhi.TextField.Boxed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/et"
                app:boxBackgroundColor="@color/ds_surface_container_high"
                app:boxStrokeColor="@color/ds_outline_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et"
                    style="@style/Widget.Sakhi.TextField.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:singleLine="true"
                    android:text="@{form.value}" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_label_secondary"
                style="@style/Widget.Sakhi.FieldLabel"
                asteriskRequired="@{false}"
                hintText="@{form.secondaryTitle}" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_secondary"
                style="@style/Widget.Sakhi.TextField.Boxed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/et_secondary"
                app:boxBackgroundColor="@color/ds_surface_container_high"
                app:boxStrokeColor="@color/ds_outline_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_secondary"
                    style="@style/Widget.Sakhi.TextField.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:singleLine="true"
                    android:text="@{form.secondaryValue}" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivIconBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivIconTemperature"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </LinearLayout>
</layout>
