<?xml version="1.0" encoding="utf-8"?>
<!--
    Saved-visit row in a bottom sheet · redesign (same as rv_item_hrp_track_ben): title + sync badge + action button(s)
    (tonal, sentence case), hairline between rows. Ids, bindings and clicks unchanged. Old layout: legacy_rv_item_pregnancy_anc.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="visit"
            type="org.piramalswasthya.sakhi.model.AncStatus" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.AncVisitAdapter.AncVisitClickListener" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingVertical="@dimen/ds_space_xs">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{@string/anc_visit_number(visit.visitNumber)}"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface"
                tools:text="ANC visit 1" />

            <TextView
                android:id="@+id/iv_sync_state"
                style="@style/Sakhi.Badge"
                android:layout_marginHorizontal="@dimen/ds_space_xs"
                android:contentDescription="@string/iv_sync_state_tv"
                dsSyncBadge="@{visit.syncState}"
                tools:text="Synced" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view"
                style="@style/Widget.Sakhi.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_view" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/ds_space_md"
            android:background="@color/ds_outline_variant" />
    </LinearLayout>
</layout>
