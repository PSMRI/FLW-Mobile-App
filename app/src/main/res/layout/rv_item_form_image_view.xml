<?xml version="1.0" encoding="utf-8"?>
<!--
    Photo field (old FormInputOld kit) · redesign (Figma 07 · Register member, "Photo slot"): 64dp circle
    (#EEF1F5, 1dp #72787E) + title 14/20 Medium primary + red * when required, 16dp gap, 16dp side padding.
    Same look as rv_item_form_image_view_v2. Ids and bindings unchanged; old layout: legacy_rv_item_form_image_view.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="form"
            type="org.piramalswasthya.sakhi.model.FormInputOld" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.FormInputAdapterOld.ImageClickListener" />
    </data>

    <LinearLayout
        android:id="@+id/cl_ri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingVertical="@dimen/ds_space_xs">

        <ImageView
            android:id="@+id/iv"
            benImage="@{form.value}"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_ds_photo_slot"
            android:contentDescription="@{form.title}"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:onClick="@{()->clickListener.onImageClick(form)}"
            android:padding="1dp"
            tools:src="@drawable/ic_person" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_md"
            android:text="@{form.title}"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
            android:textColor="@color/ds_primary"
            tools:text="Photo" />

        <TextView
            android:id="@+id/tv_nullable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/tv_required_text_asterisk"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
            android:textColor="@color/ds_error"
            app:required="@{form.required}"
            tools:visibility="gone" />
    </LinearLayout>
</layout>
