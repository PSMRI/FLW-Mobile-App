<?xml version="1.0" encoding="utf-8"?>
<!--
    Radio question · redesign (Figma 07 · Register member › "Gender"): label 14/20 Medium #42474E (red * when required),
    8dp, then the options as 44dp filter chips (FormInputAdapter builds them with Widget.Sakhi.RadioChip), 8dp apart.
    Ids and bindings unchanged; old layout: legacy_rv_item_form_radio_v2.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="form"
            type="org.piramalswasthya.sakhi.model.FormElement" />
    </data>

    <LinearLayout
        android:id="@+id/cl_ri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingVertical="@dimen/ds_space_xs">

        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- label with high-risk marker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                showLayout="@{(form.showHighRisk ? true : false)}">

                <LinearLayout
                    android:id="@+id/cl_text_hr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_title_hr"
                        style="@style/Widget.Sakhi.FieldLabel"
                        android:layout_width="wrap_content"
                        android:text="@{form.title}"
                        app:required="@{!form.required}"
                        tools:text="Gender" />

                    <TextView
                        android:id="@+id/tv_nullable_hr"
                        style="@style/Widget.Sakhi.FieldLabel"
                        android:layout_width="wrap_content"
                        android:text="@{(form.doubleStar? @string/radio_title_ds(form.title) : @string/radio_title(form.title))}"
                        app:required="@{form.required}" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_high_risk"
                    style="@style/Sakhi.Tag"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:backgroundTint="@color/ds_error_container"
                    android:text="@string/high_risk"
                    android:textColor="@color/ds_error"
                    app:required="@{form.showHighRisk}" />

                <ImageView
                    android:id="@+id/check_red"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/ds_space_2xs"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle_red"
                    app:imgRequired="@{form.showHighRisk}" />
            </LinearLayout>

            <!-- plain label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                showLayout="@{(form.showHighRisk ? false : true)}">

                <TextView
                    android:id="@+id/tv_title"
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:layout_width="wrap_content"
                    android:text="@{form.title}"
                    app:required2="@{!form.required}"
                    tools:text="Gender" />

                <TextView
                    android:id="@+id/tv_nullable"
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:layout_width="wrap_content"
                    android:text="@{(form.doubleStar? @string/radio_title_ds(form.title) : @string/radio_title(form.title))}"
                    app:required2="@{form.required}" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/ds_space_2xs" />
        </LinearLayout>
    </LinearLayout>
</layout>
