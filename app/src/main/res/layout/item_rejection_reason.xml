<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.12-04 reject reasons as "Checkbox option" rows (52dp, r12, gap 8).
     Old layout: legacy_item_rejection_reason.xml. Ids unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbReason"
        style="@style/Widget.Sakhi.CheckboxOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:text="Incomplete documentation" />
</LinearLayout>
