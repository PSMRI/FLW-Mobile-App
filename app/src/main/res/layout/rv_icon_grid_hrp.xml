<?xml version="1.0" encoding="utf-8"?>
<!--
    High Risk Assessment hub · redesign: same surface / grid spacing as the other module hubs (rv_icon_grid.xml);
    the solid primary section bars become section titles (TitleSmall, on-surface-variant) above each tile grid.
    Ids unchanged. Old layout: legacy_rv_icon_grid_hrp.xml.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/ds_space_2xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_md"
            android:paddingBottom="@dimen/ds_space_xs"
            android:text="@string/non_pregnant_women_eligible_couple_section"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
            android:textColor="@color/ds_on_surface_variant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_icon_grid_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/ds_space_xs"
            android:splitMotionEvents="false"
            tools:itemCount="2"
            tools:listitem="@layout/rv_item_icon_grid" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_lg"
            android:paddingBottom="@dimen/ds_space_xs"
            android:text="@string/pregnant_women_pw_section"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
            android:textColor="@color/ds_on_surface_variant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_icon_grid_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/ds_space_xs"
            android:splitMotionEvents="false"
            tools:itemCount="2"
            tools:listitem="@layout/rv_item_icon_grid" />
    </LinearLayout>
</ScrollView>
