<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.11-03 "Incentives · month" — month picker (label "Month & year" + 56dp box + filled Submit),
     claim status row with a status tag, summary stat tiles (pending purple · processed green, r16), table head 12/16,
     activity groups list, bottom action bar "Claim". Padding 16, gap 12.
     Old layout: legacy_fragment_incentives.xml. All view ids unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:orientation="vertical"
    tools:context=".ui.home_activity.incentives.IncentivesFragment">

    <!-- "Last updated on …" as a neutral banner -->
    <TextView
        android:id="@+id/tv_lastupdated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ds_banner_neutral"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
        android:textColor="@color/ds_on_surface_variant"
        android:visibility="gone"
        tools:text="Last Updated on 23-43-1234" />

    <!-- Old from/to range (hidden in the app today) -->
    <LinearLayout
        android:id="@+id/ll_date_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/from_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/from_months_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/from_years_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="to"
            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/to_months_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/to_years_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Figma "Month picker": text field (227) + Submit (gap 8) -->
    <LinearLayout
        android:id="@+id/from_to_date_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/from_date_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Sakhi.FieldLabel"
                android:text="@string/ds_month_year" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_text1"
                style="@style/Widget.Sakhi.TextField.Boxed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconDrawable="@drawable/ic_arrow_drop_down"
                app:endIconMode="custom"
                app:endIconTint="@color/ds_on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et1"
                    style="@style/Widget.Sakhi.TextField.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:singleLine="true"
                    android:text="Select Month" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fetch_data_ll"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fetch_data"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:text="Submit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Figma "Claim status": label + status tag (tap = rejection details) -->
    <LinearLayout
        android:id="@+id/claimStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/claimedStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Incentive claim status"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
            android:textColor="@color/ds_on_surface_variant" />

        <TextView
            android:id="@+id/approved"
            style="@style/Sakhi.Tag"
            android:layout_marginStart="8dp"
            android:drawableEnd="@drawable/ic_ds_info"
            android:drawablePadding="4dp"
            android:text=""
            app:drawableTint="@color/ds_on_surface_variant"
            tools:text="Pending" />
    </LinearLayout>

    <!-- Figma "Summary": two stat tiles, r16, padding 12, gap 8 (pending first) -->
    <LinearLayout
        android:id="@+id/ll_sum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_total_pending"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_stat"
            android:backgroundTint="@color/ds_module_couple_bg"
            android:drawableEnd="@drawable/ic_download"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="@string/incentive_pending"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
            android:textColor="@color/ds_module_couple_fg"
            app:drawableTint="@color/ds_module_couple_fg" />

        <TextView
            android:id="@+id/tv_total_processed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_stat"
            android:backgroundTint="@color/ds_success_container"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="@string/incentive_processed"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
            android:textColor="@color/ds_success" />
    </LinearLayout>

    <!-- Figma "Table head": 12/16 Medium on-surface-variant; 5 columns for Mitanin (old rows);
         ASHA = 3 columns S.No · Activity · No. of claims, set in code by dsIncentiveHeaderThreeColumns (phone pass 2026-11-12) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.6" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.9" />

        <TextView
            android:id="@+id/tvHeaderSerialNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="S.No"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
            android:textColor="@color/ds_on_surface_variant"
            app:layout_constraintEnd_toStartOf="@id/guideline10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Activity"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
            android:textColor="@color/ds_on_surface_variant"
            app:layout_constraintEnd_toStartOf="@id/guideline50"
            app:layout_constraintStart_toStartOf="@id/guideline10"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="No of Claims"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
            android:textColor="@color/ds_on_surface_variant"
            app:layout_constraintEnd_toStartOf="@id/guideline75"
            app:layout_constraintStart_toStartOf="@id/guideline50"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderAmount"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Amount claimed (Rs.)"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
            android:textColor="@color/ds_on_surface_variant"
            app:layout_constraintEnd_toStartOf="@id/guideline90"
            app:layout_constraintStart_toStartOf="@id/guideline75"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderDoc"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Doc"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
            android:textColor="@color/ds_on_surface_variant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline90"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_incentive"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="5"
        tools:listitem="@layout/item_activity_group" />

    <!-- Figma "Bottom action bar": Claim (shown only for a claimable month) -->
    <FrameLayout
        android:id="@+id/claimlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ds_bottom_bar"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/claimbtn"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/claim" />
    </FrameLayout>
</LinearLayout>
