<?xml version="1.0" encoding="utf-8"?>
<!-- Risk-factor tag · redesign: warning tag (same style as the "Missed period" / "Overdue" card tags). Old: legacy_rv_item_risk_factor.xml -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="riskFactor"
            type="String" />
    </data>

    <TextView
        style="@style/Sakhi.Tag"
        android:layout_marginTop="@dimen/ds_space_2xs"
        android:backgroundTint="@color/ds_warning_container"
        android:text="@{riskFactor}"
        android:textColor="@color/ds_warning"
        tools:text="Migrant worker" />

</layout>
