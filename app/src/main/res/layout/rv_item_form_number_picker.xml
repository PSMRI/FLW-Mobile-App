<?xml version="1.0" encoding="utf-8"?>
<!--
    Number field · redesign (form kit): label 14/20 above, 56dp outlined box (1dp #72787E, r12, white) with
    48dp − / + buttons in primary and the value centred 16/24; error text 12/16 red below.
    Ids and bindings unchanged; old layout: legacy_rv_item_form_number_picker.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="form"
            type="org.piramalswasthya.sakhi.model.FormElement" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingVertical="@dimen/ds_space_xs">

        <TextView
            android:id="@+id/tvLabel"
            style="@style/Widget.Sakhi.FieldLabel"
            android:text="@{form.title}"
            tools:text="No. of IFA tablets given" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerNumberPickerCard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:cardBackgroundColor="@color/ds_surface_container"
            app:cardCornerRadius="@dimen/ds_radius_md"
            app:cardElevation="0dp"
            app:strokeColor="@color/ds_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/containerNumberPicker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btnDecrement"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ds_decrease"
                    android:src="@drawable/ic_ds_remove"
                    app:tint="@color/ds_primary" />

                <EditText
                    android:id="@+id/etNumberInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="@{form.value}"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                    android:textColor="@color/ds_on_surface"
                    tools:text="0" />

                <ImageButton
                    android:id="@+id/btnIncrement"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ds_increase"
                    android:src="@drawable/ic_ds_add"
                    app:tint="@color/ds_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@{form.errorText}"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_error"
            android:visibility="@{form.errorText != null ? View.VISIBLE : View.GONE}"
            tools:text="Error message" />
    </LinearLayout>
</layout>
