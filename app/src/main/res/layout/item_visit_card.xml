<?xml version="1.0" encoding="utf-8"?>
<!--
    Visit card (dynamic HBYC months / HBNC days) · redesign: r16 card with 1dp outline; visit 16/24 medium, date 12/16,
    optional / mandatory label 11/16; View (tonal) + Add visit (filled) pills. State colours set in VisitCardAdapter
    (completed = success container, due = white, locked = grey). Ids unchanged. Old layout: legacy_item_visit_card.xml.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVisit"
    style="@style/Widget.Sakhi.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ds_space_xs"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_md">

        <TextView
            android:id="@+id/tvVisitDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
            android:textColor="@color/ds_on_surface"
            tools:text="3 Month" />

        <TextView
            android:id="@+id/tvVisitDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            tools:text="12-10-2026" />

        <TextView
            android:id="@+id/tvOptionalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2xs"
            android:text="@string/optional"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
            android:textColor="@color/ds_on_surface_variant"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnView"
                style="@style/Widget.Sakhi.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ds_view" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddVisit"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_visit" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
