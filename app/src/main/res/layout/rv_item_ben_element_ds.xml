<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign info cell for <include> grids (same variables as rv_item_ben_element: fieldTitle / field): label 11/16 grey
     over value 14/20. rv_item_ben_element stays for the old blue cards (rv_item_ben_cho, rv_item_ben_get_data). -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="fieldTitle"
            type="String" />
        <variable
            name="field"
            type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ph"
            style="@style/Sakhi.InfoLabel"
            android:text="@{fieldTitle}"
            tools:text="Date of death" />

        <TextView
            android:id="@+id/tv_val"
            style="@style/Sakhi.InfoValue"
            android:text="@{(field == null || field.empty) ? @string/ds_empty_value : field}"
            tools:text="01-04-2026" />
    </LinearLayout>
</layout>
