<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.12-02 ASHA row — white card r16, 1dp outline-variant, padding 12/16, gap 6: head = 44dp initials
     avatar (primary-container) + name 14/20 Medium / "ID · sub-centre" 12/16 + amount + status tag (colour from code via
     dsTag); status date / by / reason 12/16 variant. Old layout: legacy_item_asha_worker.xml. Ids unchanged. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sakhi.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Head -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/nameAlpha"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ds_icon_circle"
                android:backgroundTint="@color/ds_primary_container">

                <TextView
                    android:id="@+id/textShort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="AR"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                    android:textColor="@color/ds_on_primary_container" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                    android:textColor="@color/ds_on_surface"
                    tools:text="Sunita Kumari" />

                <TextView
                    android:id="@+id/tvAshaIdCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    tools:text="ID 1234 · SC Sirsi" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusBadge"
                    style="@style/Sakhi.Tag"
                    tools:text="Pending" />

                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                    android:textColor="@color/ds_on_surface"
                    tools:text="₹3,450" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            tools:text="Verified on 06 Nov 2026" />

        <TextView
            android:id="@+id/tvStatusBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            tools:text="By: Anju Sharma (Supervisor)" />

        <TextView
            android:id="@+id/tvRejectedReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            android:visibility="gone"
            tools:text="Reason: Incomplete documentation" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
