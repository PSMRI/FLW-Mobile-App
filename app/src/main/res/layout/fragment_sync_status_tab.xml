<?xml version="1.0" encoding="utf-8"?>
<!--
    Sync · status · redesign (Figma "FLW App Redesign" › 08 · Sync):
    status card (primary-container #CCE5FF, r24, padding 20, 12 gap): 32dp cloud + "N records waiting" 24/32 +
    "Saved safely on this phone" 14/20, 8dp progress (white track, primary), "x / y records synced" 12/16,
    52dp "Sync now"; failed-sync box (#FFDAD6, r12); "By module" 16/24; white module card (r16, 1dp #DCE1E8).
    Ids unchanged (tv_overall_title kept, hidden). Old layout: legacy_fragment_sync_status_tab.xml.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_md">

        <!-- ===== Sync status card ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sakhi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ds_primary_container"
            app:cardCornerRadius="@dimen/ds_radius_xl"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_overall_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_dashboard"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_cloud_upload"
                        app:tint="@color/ds_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_waiting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Sakhi.HeadlineSmall"
                            android:textColor="@color/ds_on_primary_container"
                            tools:text="12 records waiting" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ds_sync_saved_on_phone"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                            android:textColor="@color/ds_on_primary_container" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_overall"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_ds_sync_progress" />

                <TextView
                    android:id="@+id/tv_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                    android:textColor="@color/ds_on_primary_container"
                    tools:text="1092 / 1104 records synced" />

                <TextView
                    android:id="@+id/tv_worker_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_primary_container"
                    tools:text="Idle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sync_now"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:text="@string/ds_sync_now"
                    app:icon="@drawable/ic_ds_sync"
                    app:iconGravity="textStart"
                    app:iconSize="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Failed sync help (shown by code when workers failed) ===== -->
        <TextView
            android:id="@+id/tv_worker_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:background="@drawable/bg_ds_error_box"
            android:drawablePadding="@dimen/ds_space_sm"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingVertical="@dimen/ds_space_sm"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_error_container"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_ds_error"
            app:drawableTint="@color/ds_error"
            tools:text="Failed: 3 worker(s) - tap to see details"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_failed_workers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/rv_item_failed_worker" />

        <!-- ===== By module ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:text="@string/ds_sync_by_module"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
            android:textColor="@color/ds_on_surface" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sakhi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/ds_space_md"
                android:paddingVertical="4dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/rv_item_sync_dashboard_status" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
