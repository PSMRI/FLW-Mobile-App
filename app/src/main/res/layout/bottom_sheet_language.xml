<?xml version="1.0" encoding="utf-8"?>
<!--
    Language sheet · redesign (row 26), Figma M2.19-04 "Language sheet": white sheet, 12dp top padding, 32×4 handle (#72787E),
    title 22/28, 24dp bottom padding. Language tiles (item_language) are restyled with the utility screens.
    Ids unchanged. Old layout: legacy_bottom_sheet_language.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_sheet_g26"
    android:orientation="vertical"
    android:paddingTop="@dimen/ds_space_sm"
    android:paddingBottom="@dimen/ds_space_xl">

    <!-- Drag Handle -->
    <View style="@style/Sakhi.G26.SheetHandle" />

    <!-- Title -->
    <TextView
        style="@style/Sakhi.G26.SheetTitle"
        android:text="@string/tv_text_select_language" />

    <!-- Grid RecyclerView — 3 columns -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_languages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="@dimen/ds_space_xs" />

</LinearLayout>
