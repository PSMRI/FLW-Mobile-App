<?xml version="1.0" encoding="utf-8"?>
<!--
    Sync · module row · redesign (Figma 08 · Sync › "Module status" row): padding 12/0, name 14/20 Medium,
    "N records · M waiting" 12/16 #42474E, sync badge at the end (Synced / Not synced / Syncing).
    The old count cells (tv_synced / tv_unsynced / tv_syncing) are kept for their ids, hidden.
    Old layout: legacy_rv_item_sync_dashboard_status.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/ds_space_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_entity_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
            android:textColor="@color/ds_on_surface"
            tools:text="Beneficiaries" />

        <TextView
            android:id="@+id/tv_records"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            tools:text="1,104 records · 4 waiting" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status_badge"
        style="@style/Sakhi.Badge"
        android:layout_marginStart="@dimen/ds_space_sm"
        tools:text="Synced" />

    <TextView
        android:id="@+id/tv_synced"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_unsynced"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_syncing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
