<?xml version="1.0" encoding="utf-8"?>
<!--
    Monthly Recap language selection (Phase 2).

    Story: ASHA-didi pops in and welcomes the ASHA; her open-palm gesture leads the
    eye to the bilingual instruction and the two equal-weight language options.
    Selection requires an explicit tap (no auto-select from app language, no
    carousel auto-confirm, no swipe needed, no flags).

    ScrollView keeps everything reachable on narrow screens and large font sizes.
    The didi image is decorative; all meaning is carried by text.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_wide"
        android:paddingTop="@dimen/padding_wide"
        android:paddingEnd="@dimen/padding_wide"
        android:paddingBottom="@dimen/margin_huge">

        <!-- Animated welcome character (Lottie): waves + blinks + greets, looping.
             Kept modestly sized (180dp square) so it never dominates the screen.
             Decorative; autoPlay is driven from code to respect reduced-motion. -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/recap_lang_didi"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/padding_normal"
            android:contentDescription="@null"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/recap_didi_welcome" />

        <TextView
            android:id="@+id/recap_lang_instruction_hi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_wide"
            android:gravity="center"
            android:text="@string/monthly_recap_lang_instruction_hi"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recap_lang_instruction_as"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_normal"
            android:gravity="center"
            android:text="@string/monthly_recap_lang_instruction_as"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <!-- Two equal-weight, explicitly tappable language options -->
        <LinearLayout
            android:id="@+id/recap_lang_options_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_huge"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recap_lang_card_hindi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding_normal"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:rippleColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/recap_lang_text_hindi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="88dp"
                    android:padding="@dimen/padding_wide"
                    android:text="@string/monthly_recap_lang_hindi"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recap_lang_card_assamese"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_normal"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:rippleColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/recap_lang_text_assamese"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="88dp"
                    android:padding="@dimen/padding_wide"
                    android:text="@string/monthly_recap_lang_assamese"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Selection confirmation (hidden until an explicit tap) -->
        <TextView
            android:id="@+id/recap_lang_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_wide"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="आपने हिन्दी चुनी है" />
    </LinearLayout>
</ScrollView>
