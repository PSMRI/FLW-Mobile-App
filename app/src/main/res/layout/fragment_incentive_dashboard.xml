<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.12-01 / -13 "Supervisor home · verification dashboard" — month + sub-centre pickers (56dp boxes,
     gap 12), stat tiles r16 padding 12/16 (count 22/28 Bold in the tone colour + 20dp icon, label 14/20, note 12/16):
     total ASHAs (people tone, full width), pending (warning) · overdue (error), verified (success) · rejected (grey),
     not claimed (village tone, full width), sub-centres card. Padding 16, gap 12.
     cardPending stays a direct ConstraintLayout child (code edits its LayoutParams).
     Old layout: legacy_fragment_incentive_dashboard.xml. Ids unchanged. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Section title "Incentive verification" + pickers -->
            <TextView
                android:id="@+id/tvIncentiveTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/incentive_verification"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/tilMonthYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIncentiveTitle">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMonth"
                    style="@style/Widget.Sakhi.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/ds_radius_md"
                    app:strokeColor="@color/ds_outline">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMonthLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/month"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                                android:textColor="@color/ds_on_surface_variant" />

                            <TextView
                                android:id="@+id/et1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="July 2026"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                                android:textColor="@color/ds_on_surface" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgMonth"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBlock"
                    style="@style/Widget.Sakhi.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/ds_radius_md"
                    app:strokeColor="@color/ds_outline">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBlockLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/str_sub_center"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelMedium"
                                android:textColor="@color/ds_on_surface_variant" />

                            <TextView
                                android:id="@+id/tvBlock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/all_sub_centre"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                                android:textColor="@color/ds_on_surface" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgBlock"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/ds_on_surface_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Total ASHAs (full width): logo + count/label/subtitle + chevron -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalAshas"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/ds_module_people_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilMonthYear"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/imgAsha"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/logo_circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalAshasCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                            android:textColor="@color/ds_module_people_fg" />

                        <TextView
                            android:id="@+id/tvTotalAshasLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/total_ashas"
                            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                            android:textColor="@color/ds_on_surface" />

                        <TextView
                            android:id="@+id/tvAshaSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tap_to_view_ashas_grouped"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ds_module_people_fg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPending"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/ds_warning_container"
                app:strokeWidth="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@id/cardOverdue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardTotalAshas">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                            android:textColor="@color/ds_warning" />

                        <ImageView
                            android:id="@+id/pendingIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pending"
                            app:tint="@color/ds_warning" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPendingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/pending"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tvPendingSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/awaiting_your_nverification"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOverdue"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/ds_error_container"
                app:strokeWidth="0dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardPending"
                app:layout_constraintTop_toTopOf="@id/cardPending">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOverdueCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                            android:textColor="@color/ds_error" />

                        <ImageView
                            android:id="@+id/overDueIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_overdue"
                            app:tint="@color/ds_error" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOverdueLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/overdue"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tvOverdueSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/past_verify_by_12th"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerified"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/ds_success_container"
                app:strokeWidth="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@id/cardRejected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierRow1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvVerifiedCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                            android:textColor="@color/ds_success" />

                        <ImageView
                            android:id="@+id/verifiedIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/ds_success" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvVerifiedLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/verified"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tvVerifiedSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/forwarded_to_ncho_anm"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRejected"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/ds_module_records_bg"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardVerified"
                app:layout_constraintTop_toTopOf="@id/cardVerified">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRejectedCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                            android:textColor="@color/ds_module_records_fg" />

                        <ImageView
                            android:id="@+id/rejectedIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/cross_newone"
                            app:tint="@color/ds_module_records_fg" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRejectedLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/rejected"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tvRejectedSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/back_with_asha_nfor_correction"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAshaUnclaimed"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/ds_module_village_bg"
                app:strokeWidth="0dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierRow2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAshaUnclaimedCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Sakhi.NumberMedium"
                            android:textColor="@color/ds_module_village_fg" />

                        <ImageView
                            android:id="@+id/unclaimedIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_unclaimed"
                            app:tint="@color/ds_module_village_fg" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAshaUnclaimedLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/asha_unclaimed"
                        android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                        android:textColor="@color/ds_on_surface" />

                    <TextView
                        android:id="@+id/tvAshaUnclaimedSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ashas_yet_to_submit_ntheir_monthly_claim"
                        android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                        android:textColor="@color/ds_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierRow1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="cardPending,cardOverdue" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierRow2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="cardVerified,cardRejected" />

            <!-- Figma "Sub-centres under you (n)": section header + white card list -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubcentres"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAshaUnclaimed">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSubCentreTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_center_under_you_4"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface" />

                    <View
                        android:id="@+id/underLine"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/ds_outline_variant"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/subCenterRV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="4"
                        tools:listitem="@layout/layout_list_item" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible"
        app:indicatorColor="@color/ds_primary" />
</FrameLayout>
