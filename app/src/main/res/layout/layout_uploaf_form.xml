<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-file upload row (FormInputAdapter FILE_UPLOAD) · redesign (form kit "upload row", same as
    rv_item_form_upload_image; Figma M2.2-26 field header): bordered 56dp row (white, 1dp #DCE1E8, r12) 16dp from the
    card edges — title 14/20 Medium #191C1F (up to 3 lines) · "View" text button · 24dp upload icon in a 40dp target.
    The old 100dp photo (iv, GONE) is kept for its binding. Ids and bindings unchanged; old layout: legacy_layout_uploaf_form.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="form"
            type="org.piramalswasthya.sakhi.model.FormElement" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.FormInputAdapter.SelectUploadImageClickListener" />
        <variable
            name="documentclickListener"
            type="org.piramalswasthya.sakhi.adapters.FormInputAdapter.ViewDocumentOnClick" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_ri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginVertical="@dimen/ds_space_xs"
        android:background="@drawable/bg_ds_field_row"
        android:minHeight="56dp"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_xs">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/ds_space_sm"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@{form.title}"
            android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
            android:textColor="@color/ds_on_surface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Upload File" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view"
            style="@style/Widget.Sakhi.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="@{()->documentclickListener.onViewDocumentClick(form)}"
            android:text="@string/view"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/add_file"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/add_file"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_file"
            android:onClick="@{()->clickListener.onSelectImageClick(form)}"
            android:padding="8dp"
            android:src="@drawable/ic_doc_upload"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv"
            benImage="@{form.value}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
