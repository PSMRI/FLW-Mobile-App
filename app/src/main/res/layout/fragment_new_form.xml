<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Redesign (Figma 07 · Register member): surface bg; summary card in primary-container tone; the form sits in a
         white section card (r16, 1dp #DCE1E8); Submit / Link household in a white bottom action bar with 48dp pill
         buttons. Shared by 38 form screens; ids unchanged. Old layout: legacy_fragment_new_form.xml.
         Not built (new behaviour): 3-step stepper, photo slot, "Save draft", autosave tip. -->


    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_patient_information"
                style="@style/Widget.Sakhi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ds_space_md"
                android:layout_marginTop="@dimen/ds_space_md"
                app:cardBackgroundColor="@color/ds_primary_container"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_patient_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/ll_patient_information_1"
                        app:layout_constraintTop_toTopOf="@+id/cl_patient_information"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tv_ben_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="12dp"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tv_age_gender"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_age_gender"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/child_count_ll"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/ll_patient_information_1"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp"
                            android:layout_alignParentStart="true"
                            android:text="@string/ecrdset_no_live_child"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                            android:textColor="@color/ds_on_primary_container"
                           />

                        <TextView
                            android:id="@+id/tv_no_child"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginEnd="@dimen/_44sdp"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/husband_name_ll"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/child_count_ll"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp"
                            android:layout_alignParentStart="true"
                            android:text="@string/husband_name"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                            android:textColor="@color/ds_on_primary_container"
                           />

                        <TextView
                            android:id="@+id/tv_husbandname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginEnd="@dimen/_44sdp"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/marriage_ll"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/husband_name_ll"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp"
                            android:layout_alignParentStart="true"
                            android:text="@string/marriage_date"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                            android:textColor="@color/ds_on_primary_container"
                           />

                        <TextView
                            android:id="@+id/tv_marriage_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginEnd="@dimen/_44sdp"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp"
                            android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                            android:textColor="@color/ds_on_primary_container"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/ll_patient_information_2"
                        app:layout_constraintTop_toBottomOf="@+id/ll_patient_information_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingHorizontal="@dimen/ds_space_md"
                            android:paddingVertical="6dp">
                        <LinearLayout
                            android:id="@+id/ll_ben_pwr_tracking_details_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/husband_s_name"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/husband_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tv_mob_no_ph"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/mobile_number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_ben_pwr_tracking_details_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/beneficiary_id"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/ben_id"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tv_rch_id"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/rch_id"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_ben_pwr_tracking_details_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pregnancy_weeks"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/weeks_of_preg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pmsma_lmp"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/lmp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_small">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pmsma_edd"
                                    android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                    android:textColor="@color/ds_on_primary_container" />

                                <TextView
                                    android:id="@+id/edd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                                    android:textColor="@color/ds_on_primary_container"
                                    tools:text="TextView" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                app:layout_constraintBottom_toTopOf="@+id/action_buttons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_patient_information">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Figma section card: white, r16, 1dp #DCE1E8; fields carry their own 16dp side padding -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Sakhi.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ds_space_md"
                        android:layout_marginTop="@dimen/ds_space_md"
                        android:layout_marginBottom="@dimen/ds_space_md">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/ds_space_xs">

                            <include
                                android:id="@+id/form"
                                layout="@layout/rv_input_form"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E0E0E0"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/antra_injection_details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TableLayout
                        android:id="@+id/tableAntra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:stretchColumns="0,1,2"
                        android:visibility="gone">

                        <TableRow
                            android:background="#FFF5F5F5"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/dose"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/date"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/next_due_date"
                                android:textStyle="bold" />
                        </TableRow>
                    </TableLayout>


                </LinearLayout>


            </androidx.core.widget.NestedScrollView>
            <!-- Figma "Bottom action bar": white, padding 12/16, 48dp pill buttons 12dp apart, equal widths -->
            <LinearLayout
                android:id="@+id/action_buttons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface_container"
                android:divider="@drawable/ds_gap_12"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ds_space_md"
                android:showDividers="middle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_link_household"
                    android:layout_marginVertical="@dimen/ds_space_sm"
                    style="@style/Widget.Sakhi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/link_household"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit"
                    android:layout_marginVertical="@dimen/ds_space_sm"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_submit" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/action_buttons"
                android:layout_marginEnd="@dimen/padding_wide"
                android:layout_marginBottom="@dimen/padding_wide"
                android:contentDescription="@string/edit"
                android:visibility="gone"
                app:backgroundTint="@color/ds_primary"
                app:srcCompat="@drawable/ic_edit"
                app:tint="@color/ds_on_primary"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

</FrameLayout>
