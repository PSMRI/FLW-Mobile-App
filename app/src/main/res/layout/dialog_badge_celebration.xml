<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="340dp"
    android:layout_height="500dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_celebration"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/padding_wide">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tv_celebration_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_celebration_title"
                android:textColor="?attr/colorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_celebration_badge"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="@dimen/padding_small"
                android:contentDescription="@string/badge_celebration_title"
                android:scaleType="centerInside"
                tools:src="@drawable/badge_steady_syncer_t1" />

            <TextView
                android:id="@+id/tv_celebration_badge_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Steady Syncer" />

            <TextView
                android:id="@+id/tv_celebration_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Level 2"
                tools:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/badge_celebration_body"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <org.piramalswasthya.sakhi.badges.BadgeConfettiView
        android:id="@+id/confetti_celebration"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
