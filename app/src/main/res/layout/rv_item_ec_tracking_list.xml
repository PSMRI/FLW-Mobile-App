<?xml version="1.0" encoding="utf-8"?>
<!--
    EC tracking card · redesign (Figma "FLW App Redesign" › M2.3-04 · EC tracking list), same card pattern as the
    EC registration card: initials avatar + name 16/24 + "W/o husband · age" (built in the adapter) + sync badge;
    tags "Missed period" (error) / "No visit in last 3 months" (warning), same rules as the old icons;
    2-column values; Add visit (filled) + View visit (tonal, shown when visits exist).
    Every id, binding and click is kept. Old layout: legacy_rv_item_ec_tracking_list.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="org.piramalswasthya.sakhi.model.BenWithEctListDomain" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.ECTrackingListAdapter.ECTrackListClickListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_content"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:id="@+id/ll_title_ec_tracking_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ds_pill"
                    android:backgroundTint="@color/ds_primary_container">

                    <TextView
                        dsInitials="@{item.ben.benFullName}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container"
                        tools:text="ND" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_hh_ec_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{item.ben.benFullName}"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_surface"
                        tools:text="Neha Devi" />

                    <LinearLayout
                        android:id="@+id/ll_ec_tracking_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                            android:textColor="@color/ds_on_surface_variant"
                            tools:text="W/o Rahul Reddy · 36 Years 5 Months" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/iv_sync_state"
                    style="@style/Sakhi.Badge"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:contentDescription="@string/iv_sync_state_tv"
                    dsSyncBadge="@{item.allSynced}"
                    tools:text="Synced" />
            </LinearLayout>

            <!-- ===== Tags ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/iv_miss_state"
                    style="@style/Sakhi.Tag"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:backgroundTint="@color/ds_error_container"
                    android:text="@string/missed_period"
                    android:textColor="@color/ds_error"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/iv_follow_state"
                    style="@style/Sakhi.Tag"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:backgroundTint="@color/ds_warning_container"
                    android:text="@string/icon_title_no_follow_up"
                    android:textColor="@color/ds_warning"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ===== Values ===== -->
            <LinearLayout
                android:id="@+id/linear_ec_tracking_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_ec_tracking_details_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/beneficiary_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            dsBenIdText="@{item.ben.benId}"
                            tools:text="318468053606" />
                    </LinearLayout>

                    <LinearLayout style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_mob_no_ph" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{item.ben.mobileNo}"
                            tools:text="9391345768" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/tv_rch_id" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{(item.ben.rchId == null || item.ben.rchId.empty) ? @string/ds_empty_value : item.ben.rchId}"
                            tools:text="123456789012" />
                    </LinearLayout>

                    <LinearLayout style="@style/Sakhi.InfoCell">

                        <TextView
                            android:id="@+id/tv_weeks_of_pregnancy_ph"
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/no_of_children" />

                        <TextView
                            style="@style/Sakhi.InfoValue"
                            android:text="@{item.numChildren}"
                            tools:text="0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- LMP · status · last visit (only when they apply; the adapter hides them otherwise) -->
                <LinearLayout
                    android:id="@+id/ll_ec_tracking_details_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llLmpDate"
                        style="@style/Sakhi.InfoCell"
                        android:layout_marginEnd="@dimen/ds_space_xs">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/lmp_date" />

                        <TextView
                            android:id="@+id/benLmpDate"
                            style="@style/Sakhi.InfoValue"
                            tools:text="22-08-2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llBenStatus"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/status" />

                        <TextView
                            android:id="@+id/benStatus"
                            style="@style/Sakhi.InfoValue"
                            tools:text="Missed Period" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_ec_tracking_details_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llVisitDate"
                        style="@style/Sakhi.InfoCell">

                        <TextView
                            style="@style/Sakhi.InfoLabel"
                            android:text="@string/last_visit_date" />

                        <TextView
                            android:id="@+id/benVisitDate"
                            style="@style/Sakhi.InfoValue"
                            tools:text="12-10-2026" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Actions ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add"
                    style="@style/Widget.Sakhi.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> clickListener.onClickedAdd(item)}"
                    android:text="@string/add_visit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all_tracks"
                    style="@style/Widget.Sakhi.Button.Tonal"
                    list_avail="@{item.savedECTRecords}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> clickListener.onClickedShowAllTracks(item)}"
                    android:text="@string/view_visit" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
