<?xml version="1.0" encoding="utf-8"?>
<!--
    Developer mode sheet · redesign (Figma M2.19-18 · Dev mode PIN › "Sheet · Dev mode"): white, padding 12/16/24/16,
    gap 12, 32×4 #72787E handle, title "Enable developer mode" 22/28 Medium centred, "PIN" label 14/20 Medium above a
    56dp boxed field (r12, Body/Large, number input), 48dp filled "Enable" button.
    Ids unchanged (editText is now a TextInputEditText — an EditText subclass; Kotlin only reads / clears the text).
    Not built: red label + "Invalid PIN!" helper under the box (app shows a toast). Old layout:
    legacy_bottom_sheet_enable_dev_mode.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_bottom_sheet_r24"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_space_md"
    android:paddingTop="@dimen/ds_space_sm"
    android:paddingEnd="@dimen/ds_space_md"
    android:paddingBottom="@dimen/ds_space_xl">

    <View style="@style/Widget.Sakhi.G27.SheetHandle" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:gravity="center"
        android:text="@string/ds_g27_enable_dev_mode"
        android:textAppearance="@style/TextAppearance.Sakhi.TitleLarge"
        android:textColor="@color/ds_on_surface" />

    <TextView
        style="@style/Widget.Sakhi.FieldLabel"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:labelFor="@id/editText"
        android:text="@string/ds_g27_pin" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Sakhi.TextField.Boxed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText"
            style="@style/Widget.Sakhi.TextField.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button5"
        style="@style/Widget.Sakhi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/ds_g27_enable" />

</LinearLayout>
