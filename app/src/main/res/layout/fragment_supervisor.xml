<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: Figma M2.12-01 filters (labelled 56dp boxes in two columns, gap 12) + filled 48dp Submit, module grid on
     the surface (tiles = rv_item_icon_grid, already redesigned), load progress card.
     Old layout: legacy_fragment_supervisor.xml. Ids and bindings unchanged. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.home_activity.home.HomeFragment">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="org.piramalswasthya.sakhi.ui.asha_supervisor.supervisor.SupervisorViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface"
        android:orientation="vertical">

        <!-- Old from/to range (hidden in the app today) -->
        <LinearLayout
            android:id="@+id/ll_date_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/from_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/from_months_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />

                <Spinner
                    android:id="@+id/from_years_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="to" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/to_months_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />

                <Spinner
                    android:id="@+id/to_years_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 1: month · sub-centre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:text="Month/Year" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_month_year"
                    style="@style/Widget.Sakhi.TextField.Boxed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tiet_month_year"
                        style="@style/Widget.Sakhi.TextField.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:focusable="false"
                        android:hint="Month/Year"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="invisible">

                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:text="Subcenter" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_subcenter"
                    style="@style/Widget.Sakhi.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:visibility="invisible"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/tiet_subcenter"
                        style="@style/Widget.Sakhi.TextField.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:hint="Subcenter"
                        android:importantForAccessibility="yes"
                        android:inputType="none"
                        android:maxLines="1"
                        android:contentDescription="Subcenter dropdown"
                        tools:ignore="SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: village · ASHA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:text="Village" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_village"
                    style="@style/Widget.Sakhi.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/tiet_village"
                        style="@style/Widget.Sakhi.TextField.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:hint="Village"
                        android:importantForAccessibility="yes"
                        android:inputType="none"
                        android:maxLines="1"
                        android:contentDescription="village_dropdown"
                        listItems="@{viewModel.villageList}"
                        tools:ignore="SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sakhi.FieldLabel"
                    android:text="ASHA Worker" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_asha"
                    style="@style/Widget.Sakhi.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/tiet_asha"
                        style="@style/Widget.Sakhi.TextField.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:hint="ASHA Worker"
                        android:importantForAccessibility="yes"
                        android:inputType="none"
                        android:maxLines="1"
                        android:contentDescription="village_dropdown"
                        tools:ignore="SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_submit" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_icon_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp"
            android:splitMotionEvents="false"
            tools:itemCount="2"
            tools:listitem="@layout/rv_item_icon_grid" />

        <!-- Download progress: white card strip, 14/20 + 8dp bar -->
        <LinearLayout
            android:id="@+id/ll_full_load_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_bottom_bar"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_load_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_fragment_percent_download_text"
                android:textAppearance="@style/TextAppearance.Sakhi.LabelLarge"
                android:textColor="@color/ds_on_surface" />

            <ProgressBar
                android:id="@+id/pb_load_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ds_primary"
                android:progressTint="@color/ds_primary" />
        </LinearLayout>
    </LinearLayout>
</layout>
