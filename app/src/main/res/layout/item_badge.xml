<?xml version="1.0" encoding="utf-8"?>
<!--
  Shelf row: artwork, badge name, and one line on what earns it. No numbers here —
  progress belongs on the dashboard card, which is where she looks for "how far am I".
  This screen answers a different question: which badges exist, and what are they for.
  Redesign: Figma M2.1-02 badge tile as a card row — white r16, 1dp outline-variant, padding 16, gap 12:
  72dp medal, name 16/24, description 14/20 variant. Old layout: legacy_item_badge.xml. Ids unchanged.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sakhi.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iv_badge_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/badge_shelf_title"
            android:scaleType="centerInside"
            tools:src="@drawable/badge_steady_syncer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_badge_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_surface"
                tools:text="Steady Syncer" />

            <TextView
                android:id="@+id/tv_badge_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                android:textColor="@color/ds_on_surface_variant"
                tools:text="Sync your app at least once every week" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
