<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="form"
            type="org.piramalswasthya.sakhi.model.FormElement" />
    </data>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/ds_space_xs">

        <!-- Redesign: tonal 48dp pill (greys out while disabled), 16dp from the card edge. Old: legacy_rv_item_form_btn.xml -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/generate_otp"
            style="@style/Widget.Sakhi.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:layout_marginEnd="@dimen/ds_space_md"
            android:text="@string/send_otp"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/timerInSec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
            android:textColor="@color/ds_on_surface_variant"
            app:layout_constraintTop_toBottomOf="@+id/generate_otp"
            app:layout_constraintEnd_toEndOf="@+id/generate_otp"
            app:layout_constraintStart_toStartOf="@+id/generate_otp"/>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_text"
            style="@style/Widget.Sakhi.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            android:layout_marginStart="@dimen/ds_space_md"
            android:layout_marginEnd="@dimen/ds_space_md"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:visibility="gone"
            app:errorEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timerInSec">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:hint="@string/enter_otp"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:singleLine="true"
                android:text="@{form.value}"
                android:textAppearance="@style/TextAppearance.Sakhi.BodyLarge"
                tools:text="123456" />

        </com.google.android.material.textfield.TextInputLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>