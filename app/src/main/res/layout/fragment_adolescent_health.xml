<?xml version="1.0" encoding="utf-8"?>
<!--
    Adolescent health form · redesign (row 26), shell of fragment_new_form (Figma 07 · Register member / M2.4-11 Adolescent health):
    surface bg, beneficiary summary card in primary-container (r16, 16dp margins, on-primary-container text), the form in a white
    section card that fills the rest (the form list scrolls inside it), edit FAB in primary, Submit = 48dp pill in a white bottom action
    bar (collapses when Submit is hidden). Ids unchanged. Old layout: legacy_fragment_adolescent_health.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_patient_information"
            style="@style/Widget.Sakhi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ds_space_md"
            android:layout_marginTop="@dimen/ds_space_md"
            app:cardBackgroundColor="@color/ds_primary_container"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_patient_information"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/ll_patient_information_1"
                    app:layout_constraintTop_toTopOf="@+id/cl_patient_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_ben_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="@dimen/padding_normal"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                        android:textColor="@color/ds_on_primary_container"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_age_gender"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_age_gender"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="@dimen/padding_normal"
                        android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                        android:textColor="@color/ds_on_primary_container"
                        app:layout_constraintEnd_toEndOf="parent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_patient_information_2"
                    app:layout_constraintTop_toBottomOf="@+id/ll_patient_information_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="@dimen/padding_normal"
                    >
                    <LinearLayout
                        android:id="@+id/ll_ben_pwr_tracking_details_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/husband_s_name"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/husband_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_mob_no_ph"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/mobile_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_ben_pwr_tracking_details_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/beneficiary_id"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/ben_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_rch_id"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/rch_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_ben_pwr_tracking_details_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pregnancy_weeks"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/weeks_of_preg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pmsma_lmp"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/lmp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pmsma_edd"
                                android:textAppearance="@style/TextAppearance.Sakhi.LabelSmall"
                                android:textColor="@color/ds_on_primary_container" />

                            <TextView
                                android:id="@+id/edd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Sakhi.BodyMedium"
                                android:textColor="@color/ds_on_primary_container"
                                tools:text="TextView" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Figma section card: white, r16, 1dp #DCE1E8; the form list scrolls inside it -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sakhi.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/ds_space_md"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="@dimen/ds_space_xs">

                <include
                    android:id="@+id/form"
                    layout="@layout/rv_input_form"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/ds_space_md"
                    android:layout_marginBottom="@dimen/ds_space_md"
                    android:contentDescription="@string/edit"
                    android:visibility="gone"
                    app:backgroundTint="@color/ds_primary"
                    app:srcCompat="@drawable/ic_edit"
                    app:tint="@color/ds_on_primary"
                    tools:visibility="visible" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Figma "Bottom action bar": white, padding 12/16, 48dp pill (padding on the button so the bar collapses when it is hidden) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_bottom_bar"
            android:paddingHorizontal="@dimen/ds_space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                style="@style/Widget.Sakhi.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/ds_space_sm"
                android:text="@string/btn_submit" />
        </FrameLayout>

    </LinearLayout>



    <ProgressBar
        android:id="@+id/pb_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/ds_primary"
        android:visibility="gone" />



</FrameLayout>