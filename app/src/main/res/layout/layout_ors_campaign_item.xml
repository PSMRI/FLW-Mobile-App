<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_ors_campaign_item · redesign.
    Generated by design/redesign-tools/convert_simple_card.py (redesign card: title + icons, label/value grid, tonal action).
    Every TextView / ImageView / Button id, binding and click is kept. Old layout: legacy_layout_ors_campaign_item.xml.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <data>
        <variable
            name="orsCampaign"
            type="org.piramalswasthya.sakhi.model.ORSCampaignCache" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.sakhi.adapters.ORSCampaignAdapter.ORSCampaignClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_md"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                    android:textColor="@color/ds_on_surface"
                    android:id="@+id/tvDate"
                    android:text="@{orsCampaign.campaignDate}"
                    tools:text="01-01-2024" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:textAppearance="@style/TextAppearance.Sakhi.BodySmall"
                    android:textColor="@color/ds_on_surface_variant"
                    android:id="@+id/numberOfChildren"
                    android:text="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:divider="@drawable/ds_gap_8"
                android:gravity="end"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Sakhi.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnView"
                    android:onClick="@{() -> clickListener.onClick(orsCampaign.id)}"
                    android:text="@string/ds_view" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
