<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: HBYC form shell, same look as the shared form shell fragment_new_form (Figma 07 · Register member):
     surface bg; beneficiary summary card in primary-container tone (r16, no stroke, name 16/24 · age-gender 14/20);
     the form list sits in a white section card (r16, 1dp #DCE1E8) and scrolls inside it; Submit in a white bottom
     action bar with a 48dp pill button. Old layout: legacy_fragment_hbyc.xml. All view ids unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_patient_information"
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginTop="@dimen/ds_space_md"
        app:cardBackgroundColor="@color/ds_primary_container"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_ben_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/ds_space_md"
                android:paddingVertical="12dp"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleMedium"
                android:textColor="@color/ds_on_primary_container" />

            <TextView
                android:id="@+id/tv_age_gender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/ds_space_md"
                android:paddingVertical="12dp"
                android:textAppearance="@style/TextAppearance.Sakhi.TitleSmall"
                android:textColor="@color/ds_on_primary_container" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section card: the form list scrolls inside it -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Sakhi.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/ds_space_md"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="@dimen/ds_space_xs">

            <include
                android:id="@+id/hbyc_form"
                layout="@layout/rv_input_form"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/pb_hbyc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/ds_primary"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom action bar: white, padding 8/16, 48dp pill Submit -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface_container"
        android:elevation="4dp"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingVertical="@dimen/ds_space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hbyc_submit"
            style="@style/Widget.Sakhi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/submit" />
    </FrameLayout>
</LinearLayout>
