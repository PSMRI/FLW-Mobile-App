    <item android:title="@string/ds_menu_app">
        <menu>
            <group
                android:id="@+id/menu_group_bottom"
                android:checkableBehavior="single">
                <item
                    android:id="@+id/ChatFragment"
                    android:icon="@drawable/baseline_chat_24"
                    android:visible="true"
                    android:title="@string/help_and_support" />
                <item
                    android:id="@+id/menu_support"
                    android:checkable="false"
                    android:icon="@drawable/ic_support"
                    android:title="@string/support" />
                <item
                    android:id="@+id/menu_report_crash"
                    android:checkable="false"
                    android:icon="@drawable/ic_crash"
