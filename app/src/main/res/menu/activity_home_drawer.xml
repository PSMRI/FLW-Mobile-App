<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawer menu · redesign (Figma "FLW App Redesign" › 09 · Profile & more): items grouped under "My work", "Tools"
    and "App" section titles. Every item id, icon and title is unchanged (HomeActivity finds them by id, which also
    searches inside sections). Old menu: legacy_activity_home_drawer.xml.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:showIn="navigation_view">

    <group
        android:id="@+id/menu_group_top"
        android:checkableBehavior="single">

        <item
            android:id="@+id/homeFragment"
            android:icon="@drawable/ic_home"
            android:title="@string/home" />
        <item
            android:id="@+id/supervisorFragment"
            android:icon="@drawable/ic_home"
            android:visible="false"
            android:title="@string/menu_supervisor" />
    </group>

    <item android:title="@string/ds_menu_my_work">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/ashaProfileFragment"
                    android:icon="@drawable/ic_person"
                    android:title="@string/asha_profile" />
                <item
                    android:id="@+id/incentivesFragment"
                    android:icon="@drawable/ic__incentive"
                    android:title="@string/incentive_fragment_title" />
                <!-- The badge shelf is reached from here now. It used to be opened by a
                     progress strip on the Home grid, which spent a card's worth of space
                     on one badge and did nothing but navigate. -->
                <item
                    android:id="@+id/badgeShelfFragment"
                    android:icon="@drawable/ic_badges"
                    android:title="@string/badge_shelf_title" />
                <item
                    android:id="@+id/syncDashboardFragment"
                    android:checkable="false"
                    android:icon="@drawable/cloud_sync"
                    android:title="@string/sync_dashboard" />
            </group>
        </menu>
    </item>

    <item android:title="@string/ds_menu_tools">
        <menu>
            <item
                android:id="@+id/sync_pending_records"
                android:checkable="false"
                android:icon="@drawable/cloud_upload"
                android:title="@string/sync_records" />
            <item
                android:id="@+id/abha_id_activity"
                android:checkable="false"
                android:icon="@drawable/ic_completed_tasks"
                android:title="@string/create_abha_number" />
        </menu>
    </item>

