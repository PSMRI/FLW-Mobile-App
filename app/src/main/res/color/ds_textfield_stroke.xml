<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Text field" border: outline (#72787E) normally, primary when focused, outline-variant when disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ds_primary" android:state_focused="true" />
    <item android:color="@color/ds_outline_variant" android:state_enabled="false" />
    <item android:color="@color/ds_outline" />
</selector>
