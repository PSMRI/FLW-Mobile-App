<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Text field" box for custom inputs (Aadhaar blocks): white, r12, 1dp outline; activated = error (2dp red) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface_container" />
            <stroke android:width="2dp" android:color="@color/ds_error" />
            <corners android:radius="@dimen/ds_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface_container" />
            <stroke android:width="1dp" android:color="@color/ds_outline" />
            <corners android:radius="@dimen/ds_radius_md" />
        </shape>
    </item>
</selector>
