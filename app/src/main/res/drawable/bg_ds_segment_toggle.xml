<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Segmented option" for plain TextViews: activated = primary fill; else white + 1dp outline; r12 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_primary" />
            <corners android:radius="@dimen/ds_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface_container" />
            <stroke android:width="1dp" android:color="@color/ds_outline" />
            <corners android:radius="@dimen/ds_radius_md" />
        </shape>
    </item>
</selector>
