<?xml version="1.0" encoding="utf-8"?>
<!-- Table body row: transparent with a 1dp #DCE1E8 line at the top (separates it from the header / previous row) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/ds_outline_variant" />
        </shape>
    </item>
</layer-list>
