<?xml version="1.0" encoding="utf-8"?>
<!-- Figma form "Gender" options = filter chips, 44dp, r8: selected #CDEFF3 (no border), unselected 1dp #DCE1E8 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_secondary_container" />
            <corners android:radius="@dimen/ds_radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface_container" />
            <stroke android:width="1dp" android:color="@color/ds_outline_variant" />
            <corners android:radius="@dimen/ds_radius_sm" />
        </shape>
    </item>
</selector>
