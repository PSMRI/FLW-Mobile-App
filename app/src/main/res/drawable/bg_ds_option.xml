<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Checkbox option" / "Radio option": checked = primary-subtle + 2dp primary border; unchecked = white + outline-variant -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_primary_subtle" />
            <stroke android:width="2dp" android:color="@color/ds_primary" />
            <corners android:radius="@dimen/ds_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface_container" />
            <stroke android:width="1dp" android:color="@color/ds_outline_variant" />
            <corners android:radius="@dimen/ds_radius_md" />
        </shape>
    </item>
</selector>
