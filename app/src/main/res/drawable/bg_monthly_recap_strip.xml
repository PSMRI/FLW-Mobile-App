<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium surface for the Monthly Recap strip.
    - Calm diagonal blue gradient (brand family; deep enough for white text contrast).
    - A soft WARM orange glow low on the start side, so the ASHA-didi reads as seated
      on a warm light rather than bolted into a cold box.
    - A faint cool highlight top-end for gentle depth.
    Rounded corners are clipped by the parent MaterialCardView. All colours local.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- calm brand-blue diagonal gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1E7099"
                android:centerColor="#17608B"
                android:endColor="#104F74"
                android:type="linear" />
        </shape>
    </item>

    <!-- warm glow behind the character (bottom-start) -->
    <item
        android:width="210dp"
        android:height="210dp"
        android:bottom="-80dp"
        android:gravity="bottom|start"
        android:left="-80dp">
        <shape android:shape="oval">
            <solid android:color="#33FF7A2E" />
        </shape>
    </item>

    <!-- faint cool highlight, top-end, for depth -->
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="top|end"
        android:right="-50dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
