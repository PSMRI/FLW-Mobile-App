<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Info row" (M2.19-43): transparent row with a 1dp #DCE1E8 line at the bottom -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/ds_outline_variant" />
        </shape>
    </item>
</layer-list>
